{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "actionable",
              "licensed",
              "signal_only"
            ]
          },
          "end_byte": {
            "minimum": 1,
            "type": "integer"
          },
          "evidence_end_byte": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_start_byte": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "family": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "start_byte": {
            "minimum": 0,
            "type": "integer"
          },
          "tier": {
            "enum": [
              "hard",
              "gated",
              "structural"
            ]
          }
        },
        "required": [
          "tier",
          "family",
          "start_byte",
          "end_byte",
          "decision",
          "severity",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "annotator_id": {
      "minLength": 1,
      "type": "string"
    },
    "sample_id": {
      "pattern": "^B-(?:00[1-9]|0[1-5][0-9]|06[0-4])$",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "annotator_id",
    "annotations"
  ],
  "title": "Independent Imprimatur annotation row",
  "type": "object"
}
