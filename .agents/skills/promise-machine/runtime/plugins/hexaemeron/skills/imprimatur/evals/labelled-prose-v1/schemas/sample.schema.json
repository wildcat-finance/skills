{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection_head": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "default_branch": {
      "minLength": 1,
      "type": "string"
    },
    "default_branch_reachable": {
      "const": true
    },
    "genre": {
      "enum": [
        "technical_documentation",
        "delivery_incident_report",
        "github_change_description"
      ]
    },
    "nearest_excluded_or_selected": {
      "type": [
        "string",
        "null"
      ]
    },
    "nearest_fivegram_jaccard": {
      "exclusiveMaximum": 0.8,
      "minimum": 0,
      "type": "number"
    },
    "normalized_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "origin": {
      "enum": [
        "human",
        "model_assisted"
      ]
    },
    "origin_evidence": {
      "minProperties": 3,
      "type": "object"
    },
    "repository": {
      "pattern": "^wildcat-finance/",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[HM]-(?:TD|DR|GH)-0[1-8]-0[1-4]$",
      "type": "string"
    },
    "selection_rank_within_group": {
      "maximum": 4,
      "minimum": 1,
      "type": "integer"
    },
    "selection_seed": {
      "const": "imprimatur-labelled-prose-v1"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_end_line": {
      "minimum": 1,
      "type": "integer"
    },
    "source_group_id": {
      "pattern": "^[HM]-(?:TD|DR|GH)-0[1-8]$",
      "type": "string"
    },
    "source_object": {
      "enum": [
        "markdown_paragraph",
        "commit_message"
      ]
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_start_line": {
      "minimum": 1,
      "type": "integer"
    },
    "source_timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "source_url": {
      "pattern": "^https://github.com/wildcat-finance/",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "text",
    "text_sha256",
    "normalized_sha256",
    "repository",
    "default_branch",
    "collection_head",
    "default_branch_reachable",
    "source_group_id",
    "genre",
    "origin",
    "origin_evidence",
    "source_url",
    "source_commit",
    "source_path",
    "source_object",
    "source_start_line",
    "source_end_line",
    "source_timestamp",
    "selection_seed",
    "selection_rank_within_group",
    "nearest_excluded_or_selected",
    "nearest_fivegram_jaccard"
  ],
  "title": "Imprimatur labelled prose sample",
  "type": "object"
}
