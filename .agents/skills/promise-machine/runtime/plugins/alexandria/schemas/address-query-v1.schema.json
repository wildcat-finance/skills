{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/address-query-v1.schema.json",
  "title": "Alexandria address query v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "index", "request", "events", "observations", "coverage"],
  "properties": {
    "format": {"const": "alexandria-address-query/v1"},
    "index": {
      "type": "object", "additionalProperties": false, "required": ["logical_digest", "release_ids"],
      "properties": {
        "logical_digest": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "release_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"}}
      }
    },
    "request": {"$ref": "#/$defs/request"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event_row"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation_row"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}
  },
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["addresses", "chain", "from_time", "to_time", "venues"],
      "properties": {
        "addresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/address"}},
        "chain": {"anyOf": [{"$ref": "credit-event-v1.schema.json#/$defs/chain"}, {"type": "null"}]},
        "from_time": {"anyOf": [{"$ref": "credit-event-v1.schema.json#/$defs/decimal"}, {"type": "null"}]},
        "to_time": {"anyOf": [{"$ref": "credit-event-v1.schema.json#/$defs/decimal"}, {"type": "null"}]},
        "venues": {"type": "array", "uniqueItems": true, "items": {"$ref": "archive-manifest-v1.schema.json#/$defs/name"}}
      }
    },
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "event_row": {
      "type": "object", "additionalProperties": false, "required": ["release_id", "row_id", "row"],
      "properties": {
        "release_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "row_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "row": {"$ref": "credit-event-v1.schema.json"}
      }
    },
    "observation_row": {
      "type": "object", "additionalProperties": false, "required": ["release_id", "row_id", "row"],
      "properties": {
        "release_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "row_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "row": {"$ref": "position-observation-v1.schema.json"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["venue", "chain", "status", "empty_allowed", "records", "requested_addresses", "captures"],
      "properties": {
        "venue": {"$ref": "archive-manifest-v1.schema.json#/$defs/name"},
        "chain": {"anyOf": [{"$ref": "credit-event-v1.schema.json#/$defs/chain"}, {"type": "null"}]},
        "status": {"enum": ["covered", "partial", "uncovered"]},
        "empty_allowed": {"type": "boolean"}, "records": {"type": "integer", "minimum": 0},
        "requested_addresses": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^0x[0-9a-f]{40}$"},
          "additionalProperties": {"type": "boolean"}
        },
        "captures": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/capture"}}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["capture", "mapping", "release_id", "source_release_id"],
      "properties": {
        "capture": {"$ref": "archive-manifest-v1.schema.json#/properties/captures/items"},
        "mapping": {"$ref": "tabularium-view-v1.schema.json#/$defs/mapping"},
        "release_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
        "source_release_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"}
      }
    }
  }
}
