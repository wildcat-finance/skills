{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.wildcat.finance/schemas/alexandria-release-statement-v1.schema.json",
  "title": "Alexandria release statement v1",
  "description": "A closed in-toto Statement v1 carrying https://ariadne.wildcat.finance/alexandria-release/v1 evidence for one verified Alexandria release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 2,
      "maxItems": 129,
      "prefixItems": [
        {"$ref": "#/$defs/releaseSubject"}
      ],
      "items": {"$ref": "#/$defs/componentSubject"}
    },
    "predicateType": {
      "const": "https://ariadne.wildcat.finance/alexandria-release/v1"
    },
    "predicate": {"$ref": "#/$defs/predicate"}
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "releaseSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^release/[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "componentSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^component/[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "components", "captures", "claims", "commands"],
      "properties": {
        "release": {"$ref": "#/$defs/release"},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/component"}
        },
        "captures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/capture"}
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/verificationClaim"}
        },
        "commands": {
          "const": []
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "digest"],
      "properties": {
        "format": {"const": "alexandria-release/v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "object_path", "media_type", "bytes", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/stableName"},
        "object_path": {
          "type": "string",
          "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "pattern": "/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "component_digest", "venue", "chain", "evidence_class", "scope", "coverage"],
      "properties": {
        "id": {"$ref": "#/$defs/stableName"},
        "component": {"$ref": "#/$defs/stableName"},
        "component_digest": {"$ref": "#/$defs/digest"},
        "venue": {"$ref": "#/$defs/stableName"},
        "chain": {
          "type": "string",
          "pattern": "^eip155:(0|[1-9][0-9]*)$"
        },
        "evidence_class": {
          "enum": ["archive-log", "header-bound", "hosted-indexer", "proof-backed-state", "provider-export", "recorded-rpc"]
        },
        "scope": {"$ref": "#/$defs/scope"},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "scope": {
      "oneOf": [
        {"$ref": "#/$defs/fullDatasetScope"},
        {"$ref": "#/$defs/subjectScopedScope"}
      ]
    },
    "fullDatasetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deployment", "finality", "interval"],
      "properties": {
        "kind": {"const": "full-dataset"},
        "deployment": {"$ref": "#/$defs/stableName"},
        "finality": {"$ref": "#/$defs/finality"},
        "interval": {"$ref": "#/$defs/interval"}
      }
    },
    "subjectScopedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deployment", "finality", "interval", "subjects"],
      "properties": {
        "kind": {"const": "subject-scoped"},
        "deployment": {"$ref": "#/$defs/stableName"},
        "finality": {"$ref": "#/$defs/finality"},
        "interval": {"$ref": "#/$defs/interval"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^eip155:(0|[1-9][0-9]*):0x[0-9a-f]{40}$"
          }
        }
      }
    },
    "finality": {
      "enum": ["unknown", "provider-reported", "safe", "finalized"]
    },
    "interval": {
      "oneOf": [
        {"$ref": "#/$defs/snapshotInterval"},
        {"$ref": "#/$defs/blockRangeInterval"}
      ]
    },
    "snapshotInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at"],
      "properties": {
        "kind": {"const": "snapshot"},
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "block_number": {"$ref": "#/$defs/decimal"},
        "block_hash": {"$ref": "#/$defs/blockHash"}
      },
      "dependentRequired": {
        "block_number": ["block_hash"],
        "block_hash": ["block_number"]
      }
    },
    "blockRangeInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {
        "kind": {"const": "block-range"},
        "start": {"$ref": "#/$defs/decimal"},
        "end": {"$ref": "#/$defs/decimal"},
        "start_hash": {"$ref": "#/$defs/blockHash"},
        "end_hash": {"$ref": "#/$defs/blockHash"}
      },
      "dependentRequired": {
        "start_hash": ["end_hash"],
        "end_hash": ["start_hash"]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record_count", "collections", "unsupported_collections", "gaps"],
      "properties": {
        "status": {
          "enum": ["complete", "partial", "failed", "unsupported"]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "collections": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/collection"}
        },
        "unsupported_collections": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableName"}
        },
        "gaps": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {
            "properties": {
              "collections": {"minItems": 1},
              "unsupported_collections": {"maxItems": 0},
              "gaps": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "partial"}}, "required": ["status"]},
          "then": {
            "anyOf": [
              {"properties": {"unsupported_collections": {"minItems": 1}}},
              {"properties": {"gaps": {"minItems": 1}}}
            ]
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["failed", "unsupported"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "record_count": {"const": 0},
              "collections": {"maxItems": 0},
              "gaps": {"minItems": 1}
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "selector", "record_count"],
      "properties": {
        "name": {"$ref": "#/$defs/stableName"},
        "selector": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 1024
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verificationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subject", "disposition"],
      "properties": {
        "name": {"const": "alexandria release offline verification"},
        "subject": {"$ref": "#/$defs/digest"},
        "disposition": {"const": "passed"}
      }
    },
    "stableName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
