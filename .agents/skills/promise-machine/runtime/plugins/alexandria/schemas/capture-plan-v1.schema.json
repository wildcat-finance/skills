{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/capture-plan-v1.schema.json",
  "title": "Alexandria capture plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "release", "components", "captures"],
  "properties": {
    "format": {"const": "alexandria-capture-plan/v1"},
    "release": {"$ref": "#/$defs/release"},
    "components": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/component"}},
    "captures": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/capture"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "releaseId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release": {
      "type": "object", "additionalProperties": false, "required": ["name", "created_at"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "correction": {
          "type": "object", "additionalProperties": false, "required": ["supersedes", "reason"],
          "properties": {
            "supersedes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/releaseId"}},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["name", "path", "media_type", "role", "access", "redistribution"],
      "properties": {
        "name": {"$ref": "#/$defs/name"}, "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 3}, "role": {"$ref": "#/$defs/name"},
        "access": {"enum": ["public", "restricted", "private"]},
        "redistribution": {"enum": ["permitted", "restricted", "prohibited", "unknown"]}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component", "venue", "chain", "evidence_class", "source", "scope", "coverage"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "component": {"$ref": "#/$defs/name"}, "venue": {"$ref": "#/$defs/name"},
        "chain": {"type": "string", "pattern": "^eip155:(0|[1-9][0-9]*)$"},
        "evidence_class": {"enum": ["archive-log", "header-bound", "hosted-indexer", "proof-backed-state", "provider-export", "recorded-rpc"]},
        "source": {"$ref": "#/$defs/source"}, "scope": {"$ref": "#/$defs/scope"}, "coverage": {"$ref": "coverage-v1.schema.json"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "locator_class", "reference"],
      "properties": {
        "kind": {"$ref": "#/$defs/name"},
        "locator_class": {"enum": ["public-uri", "provider-endpoint", "chain-range", "local-fixture", "external-object", "undisclosed"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f]+$"}
      }
    },
    "scope": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "deployment", "finality", "interval"],
          "properties": {"kind": {"const": "full-dataset"}, "deployment": {"$ref": "#/$defs/name"}, "finality": {"$ref": "#/$defs/finality"}, "interval": {"$ref": "#/$defs/interval"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "deployment", "finality", "interval", "subjects"],
          "properties": {
            "kind": {"const": "subject-scoped"}, "deployment": {"$ref": "#/$defs/name"}, "finality": {"$ref": "#/$defs/finality"}, "interval": {"$ref": "#/$defs/interval"},
            "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^eip155:(0|[1-9][0-9]*):0x[0-9a-f]{40}$"}}
          }
        }
      ]
    },
    "finality": {"enum": ["unknown", "provider-reported", "safe", "finalized"]},
    "interval": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "observed_at"],
          "properties": {"kind": {"const": "snapshot"}, "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "block_number": {"type": "string", "maxLength": 78, "pattern": "^(0|[1-9][0-9]*)$"}, "block_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "start", "end"],
          "properties": {"kind": {"const": "block-range"}, "start": {"type": "string", "maxLength": 78, "pattern": "^(0|[1-9][0-9]*)$"}, "end": {"type": "string", "maxLength": 78, "pattern": "^(0|[1-9][0-9]*)$"}, "start_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}, "end_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}}
        }
      ]
    }
  }
}
