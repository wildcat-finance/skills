{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/demo-plan-v1.schema.json",
  "title": "Alexandria offline demonstration plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "release", "query", "components", "captures"],
  "properties": {
    "format": {"const": "alexandria-demo-plan/v1"},
    "release": {"$ref": "capture-plan-v1.schema.json#/properties/release"},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["addresses", "entity", "run_id"],
      "properties": {
        "addresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}},
        "entity": {"type": "string", "minLength": 1, "maxLength": 200},
        "run_id": {"$ref": "archive-manifest-v1.schema.json#/$defs/name"}
      }
    },
    "components": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "path", "repository_path", "source_sha256", "media_type", "role", "access", "redistribution"],
        "properties": {
          "name": {"$ref": "archive-manifest-v1.schema.json#/$defs/name"},
          "path": {"type": "string", "minLength": 1},
          "repository_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "source_sha256": {"$ref": "archive-manifest-v1.schema.json#/$defs/digest"},
          "media_type": {"type": "string", "minLength": 3},
          "role": {"$ref": "archive-manifest-v1.schema.json#/$defs/name"},
          "access": {"enum": ["public", "restricted", "private"]},
          "redistribution": {"enum": ["permitted", "restricted", "prohibited", "unknown"]}
        }
      }
    },
    "captures": {"$ref": "capture-plan-v1.schema.json#/properties/captures"}
  }
}
