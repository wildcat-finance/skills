{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/position-observation-v1.schema.json",
  "title": "Alexandria Tabularium position observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "row_kind", "chain", "venue", "subject", "deployment", "facility", "observation", "provenance"],
  "properties": {
    "schema": {"const": "alexandria-position-observation/v1"},
    "id": {"$ref": "credit-event-v1.schema.json#/$defs/digest"},
    "row_kind": {"const": "position-observation"},
    "chain": {"$ref": "credit-event-v1.schema.json#/$defs/chain"},
    "venue": {"$ref": "credit-event-v1.schema.json#/$defs/name"},
    "subject": {"$ref": "credit-event-v1.schema.json#/$defs/account"},
    "deployment": {"$ref": "credit-event-v1.schema.json#/$defs/name"},
    "facility": {"$ref": "credit-event-v1.schema.json#/$defs/facility"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "value", "unit", "at", "method", "evidence_class"],
      "properties": {
        "property": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9._-]*$"},
        "value": {"$ref": "credit-event-v1.schema.json#/$defs/decimal"},
        "unit": {"$ref": "credit-event-v1.schema.json#/$defs/name"},
        "method": {"$ref": "credit-event-v1.schema.json#/$defs/name"},
        "evidence_class": {"enum": ["archive-log", "header-bound", "hosted-indexer", "proof-backed-state", "provider-export", "recorded-rpc"]},
        "at": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "block_number": {"$ref": "credit-event-v1.schema.json#/$defs/decimal"},
            "block_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
            "timestamp": {"$ref": "credit-event-v1.schema.json#/$defs/decimal"}
          }
        }
      }
    },
    "terms": {
      "type": "object", "additionalProperties": false, "required": ["maturity_timestamp"],
      "properties": {"maturity_timestamp": {"$ref": "credit-event-v1.schema.json#/$defs/decimal"}}
    },
    "provenance": {"$ref": "credit-event-v1.schema.json#/$defs/provenance"}
  }
}
