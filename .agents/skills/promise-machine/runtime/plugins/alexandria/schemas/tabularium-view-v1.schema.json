{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/tabularium-view-v1.schema.json",
  "title": "Alexandria Tabularium derived view v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source_release_id", "mappings", "outputs", "counts"],
  "properties": {
    "format": {"const": "alexandria-tabularium-view/v1"},
    "source_release_id": {"$ref": "#/$defs/digest"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credit_events", "credit_observations"],
      "properties": {
        "credit_events": {
          "allOf": [
            {"$ref": "#/$defs/output"},
            {
              "properties": {
                "path": {"const": "credit-events.jsonl"},
                "schema": {"const": "alexandria-credit-event/v1"}
              }
            }
          ]
        },
        "credit_observations": {
          "allOf": [
            {"$ref": "#/$defs/output"},
            {
              "properties": {
                "path": {"const": "credit-observations.jsonl"},
                "schema": {"const": "alexandria-position-observation/v1"}
              }
            }
          ]
        }
      }
    },
    "counts": {"$ref": "#/$defs/counts"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {"type": "integer", "minimum": 0},
    "named_counts": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/nonnegative"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_records",
        "mapped_records",
        "context_records",
        "unsupported_records",
        "mapped_collections",
        "context_collections",
        "unsupported_collections"
      ],
      "properties": {
        "source_records": {"$ref": "#/$defs/nonnegative"},
        "mapped_records": {"$ref": "#/$defs/nonnegative"},
        "context_records": {"$ref": "#/$defs/nonnegative"},
        "unsupported_records": {"$ref": "#/$defs/nonnegative"},
        "mapped_collections": {"$ref": "#/$defs/named_counts"},
        "context_collections": {"$ref": "#/$defs/named_counts"},
        "unsupported_collections": {"$ref": "#/$defs/named_counts"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "adapter",
        "adapter_version",
        "mapping_revision",
        "rules",
        "coverage"
      ],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "mapping_revision": {"type": "string", "minLength": 1},
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "subject_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "observations"],
      "properties": {
        "events": {"$ref": "#/$defs/nonnegative"},
        "observations": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_families", "event_rows", "observation_rows", "subjects"],
      "properties": {
        "event_families": {
          "type": "object",
          "propertyNames": {
            "enum": ["borrowing", "repayment", "liquidation"]
          },
          "additionalProperties": {"$ref": "#/$defs/nonnegative"}
        },
        "event_rows": {"$ref": "#/$defs/nonnegative"},
        "observation_rows": {"$ref": "#/$defs/nonnegative"},
        "subjects": {
          "type": "object",
          "propertyNames": {
            "pattern": "^eip155:(0|[1-9][0-9]*):0x[0-9a-f]{40}$"
          },
          "additionalProperties": {"$ref": "#/$defs/subject_count"}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "media_type",
        "sha256",
        "bytes",
        "rows",
        "access",
        "redistribution"
      ],
      "properties": {
        "path": {"type": "string"},
        "schema": {"type": "string"},
        "media_type": {"const": "application/x-ndjson"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"$ref": "#/$defs/nonnegative"},
        "rows": {"$ref": "#/$defs/nonnegative"},
        "access": {"enum": ["public", "restricted", "private"]},
        "redistribution": {
          "enum": ["permitted", "restricted", "prohibited", "unknown"]
        }
      }
    }
  }
}
