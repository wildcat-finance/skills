{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/archive-manifest-v1.schema.json",
  "title": "Alexandria raw release manifest v1",
  "description": "The runtime applies cross-field identity, ordering, path, scope and coverage checks in addition to this structural schema.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "release_id", "release", "components", "captures"],
  "properties": {
    "format": {"const": "alexandria-release/v1"}, "release_id": {"$ref": "#/$defs/digest"},
    "release": {"$ref": "capture-plan-v1.schema.json#/$defs/release"},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "object_path", "media_type", "role", "access", "redistribution", "sha256", "bytes"],
        "properties": {
          "name": {"$ref": "#/$defs/name"}, "object_path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 3}, "role": {"$ref": "#/$defs/name"},
          "access": {"enum": ["public", "restricted", "private"]},
          "redistribution": {"enum": ["permitted", "restricted", "prohibited", "unknown"]},
          "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "captures": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "component", "component_sha256", "venue", "chain", "evidence_class", "source", "scope", "coverage"],
        "properties": {
          "id": {"$ref": "#/$defs/name"}, "component": {"$ref": "#/$defs/name"},
          "component_sha256": {"$ref": "#/$defs/digest"}, "venue": {"$ref": "#/$defs/name"},
          "chain": {"type": "string", "pattern": "^eip155:(0|[1-9][0-9]*)$"},
          "evidence_class": {"enum": ["archive-log", "header-bound", "hosted-indexer", "proof-backed-state", "provider-export", "recorded-rpc"]},
          "source": {"$ref": "capture-plan-v1.schema.json#/$defs/source"}, "scope": {"$ref": "capture-plan-v1.schema.json#/$defs/scope"},
          "coverage": {"$ref": "coverage-v1.schema.json"}
        }
      }
    },
    "derivation": {"$ref": "tabularium-view-v1.schema.json"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
