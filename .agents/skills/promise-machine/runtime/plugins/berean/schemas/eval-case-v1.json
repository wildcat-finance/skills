{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berean.wildcat.finance/eval-cases/v1/schema.json",
  "title": "Berean evaluation cases v1",
  "description": "The self-contained cases file for berean-eval-cases/v1. Each case embeds the recorded answer it grades, so a deliberately broken answer never lives among a release's shipped ones; the embedded answer is left loose here because a case whose expectation is rejected exists to carry an answer the checker must refuse. The graders enforce what this schema cannot: expectation semantics, boundary membership and forbidden-content scans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cases"],
  "properties": {
    "format": { "const": "berean-eval-cases/v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "question", "expectation", "adversarial", "expected_boundary", "forbidden_content", "answer"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "family": { "type": "string", "pattern": "\\S" },
          "question": { "type": "string", "pattern": "\\S" },
          "expectation": { "enum": ["grounded-answer", "refusal", "discrepancy-disclosed", "policy-preserved", "rejected"] },
          "adversarial": {
            "oneOf": [
              { "type": "null" },
              { "enum": ["prompt-injection", "poisoned-document", "stale-state", "citation-mismatch", "unsupported-inference"] }
            ]
          },
          "expected_boundary": {
            "oneOf": [ { "type": "null" }, { "type": "string", "pattern": "\\S" } ]
          },
          "forbidden_content": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
          "answer": { "type": "object" }
        }
      }
    }
  }
}
