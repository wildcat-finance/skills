{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/tabularium/coverage-manifest-v2.json",
  "title": "Tabularium coverage manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source",
    "capture_manifest",
    "canonical",
    "coverage",
    "versions",
    "known_gaps"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "release": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "evidence_class",
        "protocol_generation",
        "source_api",
        "chain",
        "scope"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "evidence_class": {"type": "string", "minLength": 1},
        "protocol_generation": {"enum": ["euler-v1", "euler-v2"]},
        "source_api": {"enum": ["ethereum-json-rpc", "euler-v3"]},
        "chain": {"const": "ethereum-mainnet"},
        "scope": {"type": "object"}
      }
    },
    "capture_manifest": {"$ref": "#/$defs/artifact"},
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "rows": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_events", "unsupported_events"],
      "properties": {
        "included_events": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "unsupported_events": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_schema", "adapter", "mapping_rules"],
      "properties": {
        "event_schema": {"const": 2},
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"enum": ["euler-v1", "euler-v2"]},
            "version": {"const": "1.0.0"}
          }
        },
        "mapping_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
