{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/tabularium/compound-v3-execution-fact-v1.json",
  "title": "Tabularium Compound v3 Phase 0 execution fact",
  "oneOf": [{"$ref": "#/$defs/call"}, {"$ref": "#/$defs/storageWrite"}, {"$ref": "#/$defs/principalTransition"}],
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "word": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "path": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "json_pointer", "sha256"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "common": {
      "type": "object",
      "required": ["format", "kind", "transaction_hash", "block_hash", "implementation", "implementation_code_sha256"],
      "properties": {
        "format": {"const": "tabularium-compound-v3-execution-fact/v1"},
        "kind": {"enum": ["call", "storage-write", "principal-transition"]},
        "transaction_hash": {"$ref": "#/$defs/hash"},
        "block_hash": {"$ref": "#/$defs/hash"},
        "implementation": {"$ref": "#/$defs/address"},
        "implementation_code_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "call": {
      "allOf": [{"$ref": "#/$defs/common"}, {
        "type": "object", "additionalProperties": false,
        "required": ["format", "kind", "transaction_hash", "block_hash", "implementation", "implementation_code_sha256", "call_path", "call_type", "caller", "input", "ordinal", "output", "selector", "source", "success", "target"],
        "properties": {
          "format": {}, "kind": {"const": "call"}, "transaction_hash": {}, "block_hash": {}, "implementation": {}, "implementation_code_sha256": {},
          "call_path": {"$ref": "#/$defs/path"}, "call_type": {"const": "CALL"}, "caller": {"$ref": "#/$defs/address"},
          "input": {"type": "string", "pattern": "^0x[0-9a-f]*$"}, "ordinal": {"type": "integer", "minimum": 0},
          "output": {"type": "string", "pattern": "^0x[0-9a-f]*$"}, "selector": {"enum": ["0x90323177", "0x26441318"]},
          "source": {"$ref": "#/$defs/source"}, "success": {"const": true}, "target": {"const": "0xc3d688b66703497daa19211eedff47f25384cdc3"}
        }
      }]
    },
    "storageWrite": {
      "allOf": [{"$ref": "#/$defs/common"}, {
        "type": "object", "additionalProperties": false,
        "required": ["format", "kind", "transaction_hash", "block_hash", "implementation", "implementation_code_sha256", "call_path", "depth", "opcode_index", "ordinal", "pc", "prior_word", "slot", "source", "storage_address", "written_word"],
        "properties": {
          "format": {}, "kind": {"const": "storage-write"}, "transaction_hash": {}, "block_hash": {}, "implementation": {}, "implementation_code_sha256": {},
          "call_path": {"$ref": "#/$defs/path"}, "depth": {"const": 3}, "opcode_index": {"type": "integer", "minimum": 0},
          "ordinal": {"type": "integer", "minimum": 0}, "pc": {"type": "integer", "minimum": 0}, "prior_word": {"$ref": "#/$defs/word"},
          "slot": {"$ref": "#/$defs/word"}, "source": {"$ref": "#/$defs/source"},
          "storage_address": {"const": "0xc3d688b66703497daa19211eedff47f25384cdc3"}, "written_word": {"$ref": "#/$defs/word"}
        }
      }]
    },
    "principalTransition": {
      "allOf": [{"$ref": "#/$defs/common"}, {
        "type": "object", "additionalProperties": false,
        "required": ["format", "kind", "transaction_hash", "block_hash", "implementation", "implementation_code_sha256", "account", "base_borrow_index", "packed_after", "packed_before", "principal_after", "principal_before", "principal_delta", "slot", "sources"],
        "properties": {
          "format": {}, "kind": {"const": "principal-transition"}, "transaction_hash": {}, "block_hash": {}, "implementation": {}, "implementation_code_sha256": {},
          "account": {"$ref": "#/$defs/address"}, "base_borrow_index": {"type": "integer", "minimum": 1},
          "packed_after": {"$ref": "#/$defs/word"}, "packed_before": {"$ref": "#/$defs/word"},
          "principal_after": {"type": "integer"}, "principal_before": {"type": "integer"}, "principal_delta": {"type": "integer"},
          "slot": {"$ref": "#/$defs/word"}, "sources": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source"}}
        }
      }]
    }
  }
}
