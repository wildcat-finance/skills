{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildcat-finance/skills/plugins/synkrisis/references/cohort-v1.schema.json",
  "title": "Synkrisis cohort v1",
  "description": "The complete declared run set after policy checks. Every run appears exactly once as included, excluded or unknown; an excluded run names the policy field responsible and an unknown run stays visible so it cannot satisfy a minimum sample count. The digest binds rule evaluation to exactly this classification.",
  "type": "object",
  "required": [
    "schema",
    "producer_contract",
    "manifest_digest",
    "policy_digest",
    "policy_name",
    "dimensions",
    "token_accounting",
    "runs",
    "included",
    "excluded",
    "unknown",
    "cohort_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "synkrisis-cohort/v1"},
    "producer_contract": {"const": "promise-machine-run-observation/v1"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "policy_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "dimensions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "token_accounting": {
      "type": "object",
      "required": ["mode", "accounting_ids"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["require-equal", "ignore"]},
        "accounting_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "disposition",
          "reason_code",
          "policy_field",
          "record",
          "sha256",
          "bytes",
          "events",
          "binding_status"
        ],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "disposition": {"enum": ["included", "excluded", "unknown"]},
          "reason_code": {
            "oneOf": [
              {"type": "null"},
              {"enum": ["dimension-mismatch", "binding-unavailable"]}
            ]
          },
          "policy_field": {
            "oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]
          },
          "record": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"$ref": "#/$defs/digest"},
          "bytes": {"type": "integer", "minimum": 1},
          "events": {"type": "integer", "minimum": 2},
          "binding_status": {"enum": ["bound", "unavailable"]}
        }
      }
    },
    "included": {"$ref": "#/$defs/runIds"},
    "excluded": {"$ref": "#/$defs/runIds"},
    "unknown": {"$ref": "#/$defs/runIds"},
    "cohort_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
