{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildcat-finance/skills/plugins/synkrisis/references/rule-v1.schema.json",
  "title": "Synkrisis rule catalogue v1",
  "description": "A digest-bound catalogue of deterministic diagnostic rules. A rule is data: it names one shipped kind and that kind's closed parameters. No rule supplies an expression, an import, a shell command, a regular expression or a format specification, and every rule stays at the inferred evidence class.",
  "type": "object",
  "required": ["schema", "catalogue", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "synkrisis-rules/v1"},
    "catalogue": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "kind",
          "title",
          "parameters",
          "required_dimensions",
          "required_fields",
          "minimum_samples",
          "evidence_class",
          "observed_relation_template",
          "nearest_forbidden_claim",
          "handoff"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}/v[0-9]{1,4}$"},
          "kind": {"enum": ["late-boundary-consultation", "unchanged-retry-before-handoff"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 4096},
          "parameters": {"type": "object"},
          "required_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "context.issue_or_topic",
                "context.promise_id",
                "context.role",
                "context.selected_skill",
                "context.step"
              ]
            }
          },
          "required_fields": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "minimum_samples": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer", "minimum": 1}
          },
          "evidence_class": {"const": "inferred"},
          "observed_relation_template": {"type": "string", "minLength": 1, "maxLength": 4096},
          "nearest_forbidden_claim": {"type": "string", "minLength": 1, "maxLength": 4096},
          "handoff": {
            "type": "object",
            "required": ["to", "reason"],
            "additionalProperties": false,
            "properties": {
              "to": {
                "enum": [
                  "ephoros",
                  "metron",
                  "elenchus",
                  "protasis",
                  "phylax",
                  "horos",
                  "human-review"
                ]
              },
              "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    }
  }
}
