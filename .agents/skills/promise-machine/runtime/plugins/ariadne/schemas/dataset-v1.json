{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.wildcat.finance/dataset/v1/schema.json",
  "title": "Ariadne dataset predicate v1",
  "description": "The predicate body of an in-toto Statement whose predicateType is https://ariadne.wildcat.finance/dataset/v1. The verifier in plugins/ariadne enforces this shape plus the gates described in docs/dataset.md; a schema cannot express those gates, which is why both ship.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "producer",
    "inputs",
    "dataset_subjects",
    "coverage",
    "deltas",
    "claims",
    "commands"
  ],
  "properties": {
    "producer": {
      "type": "object",
      "required": [
        "tool",
        "tool_version",
        "command",
        "parameters_digest"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "examples": [
            "tabularium"
          ]
        },
        "tool_version": {
          "type": "string",
          "examples": [
            "0.3.0"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The argv that produced the release. Nobody else could run it otherwise."
        },
        "parameters_digest": {
          "type": "object",
          "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Upstream artefacts the release was derived from. An empty array records that there were none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "locator"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "disposition": {
            "enum": [
              "failed",
              "skipped",
              "timed_out",
              "redacted"
            ],
            "description": "Present instead of a digest when the input could not be digested. `passed` is not available here: an input that was read carries a digest. Every value on this list needs a reason."
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "dataset_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "digest",
          "record_count"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Release-relative. Not absolute, and carrying no .. segment: a reader resolves this against the release directory, and either form would send them outside it."
          },
          "digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Read from the file, and never negative. A count taken from a filename records nothing about the file."
          }
        },
        "uniqueItemProperties": [
          "path"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "dimension",
        "start",
        "end",
        "gaps"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "examples": [
            "block"
          ]
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "gaps": {
          "type": "array",
          "description": "Sub-intervals the release does not describe. An empty array asserts the producer looked.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "reason"
            ],
            "properties": {
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "deltas": {
      "type": "object",
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "name",
                "digest"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A side that is there has to identify something. Every verifier here refuses a name that is absent or only whitespace, and a schema accepting one publishes a shape the tool will not take.",
                  "pattern": "\\S"
                },
                "digest": {
                  "type": "object",
                  "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]+$"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "object",
          "required": [
            "name",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "A side that is there has to identify something. Every verifier here refuses a name that is absent or only whitespace, and a schema accepting one publishes a shape the tool will not take.",
              "pattern": "\\S"
            },
            "digest": {
              "type": "object",
              "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]+$"
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "description": "Required when baseline is null. A first release says why there is nothing to compare against."
        },
        "records": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "baseline",
                  "current"
                ],
                "properties": {
                  "baseline": {
                    "type": "string"
                  },
                  "current": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "subject",
          "disposition"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "disposition": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "timed_out",
              "redacted"
            ]
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv",
          "determinism"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "determinism": {
            "enum": [
              "exact",
              "nondeterministic"
            ]
          },
          "output_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
