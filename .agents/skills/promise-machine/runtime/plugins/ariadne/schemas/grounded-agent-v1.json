{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.wildcat.finance/grounded-agent/v1/schema.json",
  "title": "Ariadne grounded-agent predicate v1",
  "description": "The https://ariadne.wildcat.finance/grounded-agent/v1 predicate binds a berean-release/v1 identity and its exact byte subjects without projecting evaluation conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "given",
    "produced",
    "policy",
    "adapter",
    "comparison",
    "claims",
    "commands"
  ],
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "release_version",
        "release_digest",
        "document"
      ],
      "properties": {
        "format": {
          "const": "berean-release/v1"
        },
        "release_version": {
          "$ref": "#/$defs/portableName"
        },
        "release_digest": {
          "$ref": "#/$defs/sha256"
        },
        "document": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "path": {
                  "const": "release.json"
                }
              }
            }
          ]
        }
      }
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "reads",
        "reads_absence_reason"
      ],
      "properties": {
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "corpus_version",
            "corpus_digest",
            "manifest",
            "components"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "corpus_version": {
              "$ref": "#/$defs/portableName"
            },
            "corpus_digest": {
              "$ref": "#/$defs/sha256"
            },
            "manifest": {
              "$ref": "#/$defs/component"
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/component"
              }
            }
          }
        },
        "reads": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "chain_id",
                "block_number",
                "block_hash",
                "source"
              ],
              "properties": {
                "component": {
                  "$ref": "#/$defs/component"
                },
                "chain_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "block_number": {
                  "type": "integer",
                  "minimum": 0
                },
                "block_hash": {
                  "$ref": "#/$defs/hash32"
                },
                "source": {
                  "$ref": "#/$defs/stated"
                }
              }
            }
          ]
        },
        "reads_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reads": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "reads_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reads": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "reads_absence_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "produced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers",
        "evaluations",
        "evaluations_absence_reason",
        "promotion",
        "promotion_absence_reason"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "evaluations": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cases",
                "report"
              ],
              "properties": {
                "cases": {
                  "$ref": "#/$defs/component"
                },
                "report": {
                  "$ref": "#/$defs/component"
                }
              }
            }
          ]
        },
        "evaluations_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        },
        "promotion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "format",
                "terminal"
              ],
              "properties": {
                "component": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/component"
                    },
                    {
                      "properties": {
                        "path": {
                          "const": "promotions.jsonl"
                        }
                      }
                    }
                  ]
                },
                "format": {
                  "const": "berean-promotion/v1"
                },
                "terminal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sequence",
                    "action",
                    "target_release_digest"
                  ],
                  "properties": {
                    "sequence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "action": {
                      "enum": [
                        "promote",
                        "rollback"
                      ]
                    },
                    "target_release_digest": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "action": {
                            "const": "rollback"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "sequence": {
                            "minimum": 2
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "promotion_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluations": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluations": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations_absence_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "promotion_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "promotion_absence_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_families",
        "refusal_conditions",
        "rules",
        "allowlists",
        "retention"
      ],
      "properties": {
        "question_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "refusal_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_classes",
            "evidence_classes"
          ],
          "properties": {
            "source_classes": {
              "const": [
                "document",
                "chain_read",
                "calculation",
                "user_supplied"
              ]
            },
            "evidence_classes": {
              "const": [
                "proof-backed",
                "header-bound",
                "recorded-rpc"
              ]
            }
          }
        },
        "allowlists": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chains",
            "contracts"
          ],
          "properties": {
            "chains": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "contracts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 42,
                "maxLength": 42,
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        "retention": {
          "enum": [
            "none",
            "answers-only"
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "command",
        "parameters_digest"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/portableName"
        },
        "tool_version": {
          "$ref": "#/$defs/portableName"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "parameters_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "current",
        "first_capture_reason"
      ],
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/comparisonSide"
            }
          ]
        },
        "current": {
          "$ref": "#/$defs/comparisonSide"
        },
        "first_capture_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "subject",
          "disposition"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/portableName"
          },
          "subject": {
            "$ref": "#/$defs/digest"
          },
          "disposition": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "timed_out",
              "redacted"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 4096
          },
          "detail": {
            "allOf": [
              {
                "type": "object"
              },
              {
                "$ref": "#/$defs/noBereanResults"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "failed",
                    "skipped",
                    "timed_out",
                    "redacted"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "$ref": "#/$defs/stated"
                }
              }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv",
          "determinism"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/portableName"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/stated"
            }
          },
          "determinism": {
            "enum": [
              "exact",
              "nondeterministic"
            ]
          },
          "output_digest": {
            "$ref": "#/$defs/digest"
          },
          "detail": {
            "allOf": [
              {
                "type": "object"
              },
              {
                "$ref": "#/$defs/noBereanResults"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "determinism": {
                  "const": "exact"
                }
              }
            },
            "then": {
              "required": [
                "output_digest"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparison": {
            "properties": {
              "baseline": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "first_capture_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "comparison": {
            "properties": {
              "baseline": {
                "type": "object"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "first_capture_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash32": {
      "type": "string",
      "minLength": 66,
      "maxLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "stated": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u001f\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "portableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*[!-~])(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff])\\S(?:.*\\S)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![^/\\\\]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\s)(?!.*\\/\\s)(?!.*\\s(?:\\/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff])(?=[^/\\\\]*[!-.0-\\[\\]-~])[^\\u0000/\\\\]+(?:/(?=[^/\\\\]*[!-.0-\\[\\]-~])[^\\u0000/\\\\]+)*$"
    },
    "digest": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "$ref": "#/$defs/bereanResultKey"
        }
      },
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha384": {
          "type": "string",
          "minLength": 96,
          "maxLength": 96,
          "pattern": "^[0-9a-f]{96}$"
        },
        "sha512": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]+$",
        "not": {
          "pattern": "[^0-9a-f]"
        }
      },
      "anyOf": [
        {
          "required": [
            "sha256"
          ]
        },
        {
          "required": [
            "sha384"
          ]
        },
        {
          "required": [
            "sha512"
          ]
        }
      ]
    },
    "bereanResultKey": {
      "pattern": "^(?:[Tt\u1d40\u1d57\u209c\u24c9\u24e3\uff34\uff54\ud835\udc13\ud835\udc2d\ud835\udc47\ud835\udc61\ud835\udc7b\ud835\udc95\ud835\udcaf\ud835\udcc9\ud835\udce3\ud835\udcfd\ud835\udd17\ud835\udd31\ud835\udd4b\ud835\udd65\ud835\udd7f\ud835\udd99\ud835\uddb3\ud835\uddcd\ud835\udde7\ud835\ude01\ud835\ude1b\ud835\ude35\ud835\ude4f\ud835\ude69\ud835\ude83\ud835\ude9d\ud83c\udd43][Hh\u02b0\u1d34\u2095\u210b\u210c\u210d\u210e\u24bd\u24d7\uff28\uff48\ud835\udc07\ud835\udc21\ud835\udc3b\ud835\udc6f\ud835\udc89\ud835\udcbd\ud835\udcd7\ud835\udcf1\ud835\udd25\ud835\udd59\ud835\udd73\ud835\udd8d\ud835\udda7\ud835\uddc1\ud835\udddb\ud835\uddf5\ud835\ude0f\ud835\ude29\ud835\ude43\ud835\ude5d\ud835\ude77\ud835\ude91\ud83c\udd37][Rr\u02b3\u1d3f\u1d63\u211b\u211c\u211d\u24c7\u24e1\uff32\uff52\ud835\udc11\ud835\udc2b\ud835\udc45\ud835\udc5f\ud835\udc79\ud835\udc93\ud835\udcc7\ud835\udce1\ud835\udcfb\ud835\udd2f\ud835\udd63\ud835\udd7d\ud835\udd97\ud835\uddb1\ud835\uddcb\ud835\udde5\ud835\uddff\ud835\ude19\ud835\ude33\ud835\ude4d\ud835\ude67\ud835\ude81\ud835\ude9b\ud83c\udd2c\ud83c\udd41][Ee\u1d31\u1d49\u2091\u212f\u2130\u2147\u24ba\u24d4\uff25\uff45\ud835\udc04\ud835\udc1e\ud835\udc38\ud835\udc52\ud835\udc6c\ud835\udc86\ud835\udcd4\ud835\udcee\ud835\udd08\ud835\udd22\ud835\udd3c\ud835\udd56\ud835\udd70\ud835\udd8a\ud835\udda4\ud835\uddbe\ud835\uddd8\ud835\uddf2\ud835\ude0c\ud835\ude26\ud835\ude40\ud835\ude5a\ud835\ude74\ud835\ude8e\ud83c\udd34][Ss\u017f\u02e2\u209b\u24c8\u24e2\uff33\uff53\ud835\udc12\ud835\udc2c\ud835\udc46\ud835\udc60\ud835\udc7a\ud835\udc94\ud835\udcae\ud835\udcc8\ud835\udce2\ud835\udcfc\ud835\udd16\ud835\udd30\ud835\udd4a\ud835\udd64\ud835\udd7e\ud835\udd98\ud835\uddb2\ud835\uddcc\ud835\udde6\ud835\ude00\ud835\ude1a\ud835\ude34\ud835\ude4e\ud835\ude68\ud835\ude82\ud835\ude9c\ud83c\udd42][Hh\u02b0\u1d34\u2095\u210b\u210c\u210d\u210e\u24bd\u24d7\uff28\uff48\ud835\udc07\ud835\udc21\ud835\udc3b\ud835\udc6f\ud835\udc89\ud835\udcbd\ud835\udcd7\ud835\udcf