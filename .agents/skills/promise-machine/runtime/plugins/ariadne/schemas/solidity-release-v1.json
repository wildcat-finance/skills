{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.wildcat.finance/solidity-release/v1/schema.json",
  "title": "Ariadne Solidity release predicate v1",
  "description": "The predicate body of an in-toto Statement whose predicateType is https://ariadne.wildcat.finance/solidity-release/v1. The verifier in plugins/ariadne enforces this shape plus the gates described in docs/solidity-release.md; a schema cannot express those gates, which is why both ship.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "build",
    "release_subjects",
    "deltas",
    "claims",
    "commands"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "tree_digest"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "anyOf": [
            {
              "minLength": 40,
              "maxLength": 40
            },
            {
              "minLength": 64,
              "maxLength": 64
            }
          ],
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
          "description": "A git object id, sha1 or sha256. A branch or a tag names something that moves."
        },
        "tree_digest": {
          "type": "object",
          "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "compiler",
        "compiler_version",
        "optimizer",
        "evm_version",
        "dependency_lock_digest",
        "command"
      ],
      "properties": {
        "compiler": {
          "type": "string",
          "examples": [
            "solc"
          ]
        },
        "compiler_version": {
          "type": "string",
          "examples": [
            "0.8.28"
          ]
        },
        "optimizer": {
          "type": "object",
          "required": [
            "enabled",
            "runs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "runs": {
              "type": "integer"
            }
          }
        },
        "evm_version": {
          "type": "string",
          "examples": [
            "cancun"
          ]
        },
        "via_ir": {
          "type": "boolean"
        },
        "dependency_lock_digest": {
          "type": "object",
          "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dependency_lock_source": {
          "type": "string",
          "description": "What the dependency lock digest is over: a lock file's name, or the source directory when the project pins nothing."
        }
      }
    },
    "release_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_path",
          "creation_digest",
          "runtime_digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "creation_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "runtime_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "abi_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          }
        }
      }
    },
    "deltas": {
      "type": "object",
      "description": "A comparison against the named previous release. Both sides carry a digest, or baseline is null with a reason.",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "name",
                "digest"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A side that is there has to identify something. Every verifier here refuses a name that is absent or only whitespace, and a schema accepting one publishes a shape the tool will not take.",
                  "pattern": "\\S"
                },
                "digest": {
                  "type": "object",
                  "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]+$"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "object",
          "required": [
            "name",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "A side that is there has to identify something. Every verifier here refuses a name that is absent or only whitespace, and a schema accepting one publishes a shape the tool will not take.",
              "pattern": "\\S"
            },
            "digest": {
              "type": "object",
              "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]+$"
              }
            }
          }
        },
        "reason": {
          "type": "string"
        },
        "contracts": {
          "type": "object",
          "description": "Contracts added to or removed from the build, which no ABI diff would show."
        },
        "abi": {
          "type": "object"
        },
        "method_identifiers": {
          "type": "object"
        },
        "storage": {
          "type": "object"
        }
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_digest",
          "covered_revision",
          "scope"
        ],
        "properties": {
          "report_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "covered_revision": {
            "type": "string",
            "anyOf": [
              {
                "minLength": 40,
                "maxLength": 40
              },
              {
                "minLength": 64,
                "maxLength": 64
              }
            ],
            "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
            "description": "The revision the audit covered, as a git object id."
          },
          "scope": {
            "type": "string"
          },
          "findings": {
            "type": "array"
          }
        }
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chain_id",
          "address",
          "creation_tx",
          "confirmed_against_chain"
        ],
        "properties": {
          "chain_id": {
            "type": "integer",
            "minimum": 1,
            "description": "A chain id identifies a chain, so it is a number. The verifier refused nothing here until a sweep found that ' ' and 'null' and true all satisfied its presence test and named no chain."
          },
          "address": {
            "type": "string"
          },
          "creation_tx": {
            "type": "string"
          },
          "implementation": {
            "type": "string"
          },
          "confirmed_against_chain": {
            "type": "boolean",
            "description": "False when nothing checked this deployment against a chain. Recorded rather than omitted, because an address printed with no note reads as confirmed."
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "disposition"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "disposition": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "timed_out",
              "redacted"
            ]
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "object"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argv",
          "determinism"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "determinism": {
            "enum": [
              "exact",
              "nondeterministic"
            ]
          },
          "output_digest": {
            "type": "object",
            "description": "Algorithm to lowercase hex digest. At least one of sha256, sha384 or sha512.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          },
          "detail": {
            "type": "object"
          }
        }
      }
    }
  }
}
