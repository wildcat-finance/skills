{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promise-machine-run-observation/v1",
  "title": "Promise Machine run observation v1 event",
  "description": "One closed event in a bounded host-neutral JSON Lines run observation record.",
  "oneOf": [
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/capabilityStarted" },
    { "$ref": "#/$defs/capabilityFinished" },
    { "$ref": "#/$defs/transitionRefused" },
    { "$ref": "#/$defs/retryScheduled" },
    { "$ref": "#/$defs/handoffRecorded" },
    { "$ref": "#/$defs/runFinished" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Ee][Tt]|[Nn][Oo][Nn][Ee]|[Nn]/[Aa]|[Nn][Aa]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s*(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Ee][Tt]|[Nn][Oo][Nn][Ee]|[Nn]/[Aa]|[Nn][Aa]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])\\s*$)(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "eventBase": {
      "type": "object",
      "required": [
        "schema_id",
        "run_id",
        "sequence",
        "event_id",
        "time",
        "type",
        "correlation_id"
      ],
      "properties": {
        "schema_id": { "const": "promise-machine-run-observation/v1" },
        "run_id": { "$ref": "#/$defs/identity" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1.7976931348623157e308 },
        "event_id": { "$ref": "#/$defs/identity" },
        "time": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "pattern": "^(?:(?:(?!0000)\\d{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[13579][26]|[2468][048]|0[48])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "type": { "type": "string" },
        "correlation_id": { "$ref": "#/$defs/identity" },
        "parent_event_id": { "$ref": "#/$defs/identity" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/unknown" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 128,
      "description": "Flat scalar observable facts only. The runtime rejects raw-payload and hidden-work name families, including instructions and directives, across separated, compact, camel, prefix, suffix, token and recognised acronym forms; typed bounded descriptors remain valid.",
      "x-runtime-forbidden-name-families": ["raw-payload", "hidden-work", "instruction", "directive"],
      "propertyNames": {
        "maxLength": 4096,
        "pattern": "^(?=[\\x20-\\x7E]*[A-Za-z0-9])[\\x20-\\x7E]+$"
      },
      "additionalProperties": {
        "type": ["string", "integer", "number", "boolean", "null"],
        "maxLength": 4096,
        "minimum": -1.7976931348623157e308,
        "maximum": 1.7976931348623157e308
      }
    },
    "unknown": {
      "type": "object",
      "required": ["field", "reason"],
      "properties": {
        "field": {
          "allOf": [
            { "$ref": "#/$defs/boundedString" },
            { "pattern": "^(?=[\\x20-\\x7E]*[A-Za-z0-9])[\\x20-\\x7E]+$" }
          ]
        },
        "reason": { "$ref": "#/$defs/boundedString" }
      },
      "additionalProperties": false
    },
    "hostFact": {
      "type": "object",
      "required": ["source", "identity"],
      "properties": {
        "source": { "$ref": "#/$defs/exposedFactString" },
        "identity": { "$ref": "#/$defs/exposedFactString" }
      },
      "additionalProperties": false
    },
    "exposedFactString": {
      "allOf": [
        { "$ref": "#/$defs/boundedString" },
        { "pattern": "^(?![\\s\\S]*(?:[Ee][Ss][Tt][Ii][Mm][Aa][Tt][Ee]|[Ee][Ss][Tt][Ii][Mm][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Pp][Rr][Oo][Xx][Ii][Mm][Aa][Tt]|[Gg][Uu][Ee][Ss][Ss](?:[Ee][Dd]|[Ii][Nn][Gg])?|[Hh][Ee][Uu][Rr][Ii][Ss][Tt][Ii][Cc]|[Pp][Rr][Oo][Jj][Ee][Cc][Tt](?:[Ee][Dd]|[Ii][Oo][Nn])|[Pp][Rr][Ee][Dd][Ii][Cc][Tt](?:[Ee][Dd]|[Ii][Oo][Nn])|[Ff][Oo][Rr][Ee][Cc][Aa][Ss][Tt](?:[Ee][Dd]|[Ii][Nn][Gg])?|[Bb][Aa][Ll][Ll][Pp][Aa][Rr][Kk]|[Aa][Ss][Ss][Uu][Mm](?:[Ee]|[Ee][Dd]|[Ii][Nn][Gg]|[Pp][Tt][Ii][Oo][Nn])|[Ee][Xx][Tt][Rr][Aa][Pp][Oo][Ll][Aa][Tt](?:[Ee]|[Ee][Dd]|[Ii][Nn][Gg]|[Ii][Oo][Nn])|[Mm][Oo][Dd][Ee][Ll](?:[Ee][Dd]|[Ii][Nn][Gg])|[Mm][Oo][Dd][Ee][Ll][Ll](?:[Ee][Dd]|[Ii][Nn][Gg])|[Rr][Oo][Uu][Gg][Hh]|[Aa][Pp][Pp][Rr][Oo][Xx](?:\\.|[Ii][Mm][Aa][Tt][Ee]|[Ii][Mm][Aa][Tt][Ii][Oo][Nn])?|[Dd][Ee][Rr][Ii][Vv](?:[Ee]|[Ee][Dd]|[Ii][Nn][Gg]|[Aa][Tt][Ii][Oo][Nn])|[Ii][Nn][Ff][Ee][Rr](?:[Rr][Ee][Dd]|[Rr][Ii][Nn][Gg]|[Ee][Nn][Cc][Ee])|[Cc][Aa][Ll][Cc][Uu][Ll][Aa][Tt](?:[Ee]|[Ee][Dd]|[Ii][Nn][Gg]|[Ii][Oo][Nn])|[Rr][Oo][Uu][Nn][Dd](?:[Ee][Dd]|[Ii][Nn][Gg])?|[Cc][Ii][Rr][Cc][Aa]|[Aa][Bb][Oo][Uu][Tt]|[Uu][Nn][Mm][Ee][Aa][Ss][Uu][Rr][Ee][Dd]|[Ss][Yy][Nn][Tt][Hh][Ee][Tt][Ii][Cc]|[Ss][Pp][Ee][Cc][Uu][Ll][Aa][Tt](?:[Ee]|[Ee][Dd]|[Ii][Nn][Gg]|[Ii][Oo][Nn]|[Ii][Vv][Ee])|[Bb][Ee][Ss][Tt][\\s_-]*[Ee][Ff][Ff][Oo][Rr][Tt]|[Rr][Uu][Ll][Ee][\\s_-]*[Oo][Ff][\\s_-]*[Tt][Hh][Uu][Mm][Bb]|[Ll][Ii][Kk][Ee][Ll][Yy]|[Mm][Aa][Yy][Bb][Ee]))[\\s\\S]+$" }
      ]
    },
    "runContext": {
      "type": "object",
      "required": ["issue_or_topic", "step", "role", "selected_skill", "promise_id"],
      "properties": {
        "issue_or_topic": { "$ref": "#/$defs/boundedString" },
        "step": { "$ref": "#/$defs/boundedString" },
        "role": { "$ref": "#/$defs/identity" },
        "selected_skill": { "$ref": "#/$defs/identity" },
        "promise_id": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "repositoryBefore": {
      "type": "object",
      "required": ["path", "before_commit"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Ee][Tt]|[Nn][Oo][Nn][Ee]|[Nn]/[Aa]|[Nn][Aa]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])$)(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[<>:\"\\\\|?*\\u0000-\\u001F\\u007F-\\u009F])(?!.*[\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uD800-\\uDFFF\\uFEFF\\uFFF9-\\uFFFB])(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm](?:[1-9]|\\u00B9|\\u00B2|\\u00B3)|[Ll][Pp][Tt](?:[1-9]|\\u00B9|\\u00B2|\\u00B3)|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Ll][Oo][Cc][Kk]\\$)(?:\\.[^/]*)?(?:/|$))(?!.*[. ](?:/|$))[^/]{1,255}(?:/[^/]{1,255})*$",
          "x-unicode-normalization": "NFC",
          "x-forbidden-unicode-categories": ["Cc", "Cf", "Cs"],
          "x-max-utf8-bytes-per-segment": 255,
          "x-max-total-utf8-bytes": 4096,
          "description": "A Unicode-scalar NFC repository path with no control, format, or surrogate characters, no segment over 255 UTF-8 bytes, and no total encoding over 4,096 UTF-8 bytes."
        },
        "before_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "repositoryAfter": {
      "type": "object",
      "required": ["path", "before_commit", "after_commit"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryBefore/properties/path" },
        "before_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "after_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "required": ["source", "scope", "accounting_id"],
      "properties": {
        "source": { "$ref": "#/$defs/exposedFactString" },
        "scope": { "$ref": "#/$defs/exposedFactString" },
        "accounting_id": { "$ref": "#/$defs/exposedFactString" },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308 }
      },
      "anyOf": [
        { "required": ["input_tokens"] },
        { "required": ["output_tokens"] }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "subject",
        "scope",
        "time_domain",
        "evidence_class",
        "source"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identity" },
        "subject": { "$ref": "#/$defs/boundedString" },
        "scope": { "$ref": "#/$defs/boundedString" },
        "time_domain": { "$ref": "#/$defs/boundedString" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "source": { "$ref": "#/$defs/boundedString" },
        "selector": { "$ref": "#/$defs/boundedString" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "oneOf": [
        { "required": ["selector"], "not": { "required": ["digest"] } },
        { "required": ["digest"], "not": { "required": ["selector"] } }
      ],
      "allOf": [
        {
          "if": {
            "required": ["evidence_class"],
            "properties": { "evidence_class": { "const": "inferred" } }
          },
          "then": {
            "required": ["selector"],
            "not": { "required": ["digest"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "subject", "scope", "time_domain", "evidence_class"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identity" },
        "subject": { "$ref": "#/$defs/boundedString" },
        "scope": { "$ref": "#/$defs/boundedString" },
        "time_domain": { "$ref": "#/$defs/boundedString" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      },
      "additionalProperties": false
    },
    "evidenceClass": {
      "enum": ["checked", "recomputed", "proved", "measured", "recorded", "attested", "inferred"]
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "retryRef": {
      "type": "object",
      "required": ["run_id", "event_id"],
      "properties": {
        "run_id": { "$ref": "#/$defs/identity" },
        "event_id": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["subject", "summary", "evidence_refs"],
      "properties": {
        "subject": { "$ref": "#/$defs/boundedString" },
        "summary": { "$ref": "#/$defs/boundedString" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      },
      "additionalProperties": false
    },
    "runStarted": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["subject", "scope", "context"],
          "properties": {
            "type": { "const": "run.started" },
            "subject": { "$ref": "#/$defs/boundedString" },
            "scope": { "$ref": "#/$defs/boundedString" },
            "context": { "$ref": "#/$defs/runContext" },
            "host": { "$ref": "#/$defs/hostFact" },
            "model": { "$ref": "#/$defs/hostFact" },
            "repository": { "$ref": "#/$defs/repositoryBefore" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilityStarted": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["capability_id", "capability"],
          "properties": {
            "type": { "const": "capability.started" },
            "capability_id": { "$ref": "#/$defs/identity" },
            "capability": { "$ref": "#/$defs/identity" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilityFinished": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["capability_id", "started_event_id", "status", "duration_ms"],
          "properties": {
            "type": { "const": "capability.finished" },
            "capability_id": { "$ref": "#/$defs/identity" },
            "started_event_id": { "$ref": "#/$defs/identity" },
            "status": { "enum": ["success", "refused", "failed"] },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308 },
            "evidence": { "$ref": "#/$defs/evidenceList" },
            "token_usage": { "$ref": "#/$defs/tokenUsage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "transitionRefused": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["promise_id", "blocked_transition", "reason_code", "recovery", "caused_by"],
          "properties": {
            "type": { "const": "transition.refused" },
            "promise_id": { "$ref": "#/$defs/identity" },
            "blocked_transition": { "$ref": "#/$defs/boundedString" },
            "reason_code": { "$ref": "#/$defs/identity" },
            "recovery": { "$ref": "#/$defs/boundedString" },
            "caused_by": { "$ref": "#/$defs/identity" },
            "evidence": { "$ref": "#/$defs/evidenceList" },
            "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "retryScheduled": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["retry_of", "attempt", "reason_code", "after_ms"],
          "properties": {
            "type": { "const": "retry.scheduled" },
            "retry_of": { "$ref": "#/$defs/retryRef" },
            "attempt": { "type": "integer", "minimum": 1, "maximum": 1.7976931348623157e308 },
            "reason_code": { "$ref": "#/$defs/identity" },
            "after_ms": { "type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "handoffRecorded": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["producer", "consumer", "source_event_id", "subject", "scope", "time_domain", "evidence_refs"],
          "properties": {
            "type": { "const": "handoff.recorded" },
            "producer": { "$ref": "#/$defs/identity" },
            "consumer": { "$ref": "#/$defs/identity" },
            "source_event_id": { "$ref": "#/$defs/identity" },
            "subject": { "$ref": "#/$defs/boundedString" },
            "scope": { "$ref": "#/$defs/boundedString" },
            "time_domain": { "$ref": "#/$defs/boundedString" },
            "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runFinished": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "type": "object",
          "required": ["started_event_id", "status", "outcome"],
          "properties": {
            "type": { "const": "run.finished" },
            "started_event_id": { "$ref": "#/$defs/identity" },
            "status": { "enum": ["success", "refused", "handoff", "failed"] },
            "outcome": { "$ref": "#/$defs/outcome" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308 },
            "token_usage": { "$ref": "#/$defs/tokenUsage" },
            "repository": { "$ref": "#/$defs/repositoryAfter" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
