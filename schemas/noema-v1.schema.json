{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/noema-v1.schema.json",
  "title": "Noema version 1 shadow-prototype records",
  "oneOf": [
    {
      "$ref": "#/$defs/seedInventory"
    },
    {
      "$ref": "#/$defs/module"
    },
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/build"
    },
    {
      "$ref": "#/$defs/projection"
    },
    {
      "$ref": "#/$defs/semanticDiff"
    },
    {
      "$ref": "#/$defs/lock"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/sliceProjection"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/evidence"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "not": { "pattern": "\\.\\." }
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]{0,127}|precedence:[A-Za-z][A-Za-z0-9_.-]{0,127}>[A-Za-z][A-Za-z0-9_.-]{0,127})$"
    },
    "artifactLeaf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$"
    },
    "seedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "seedInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "archive",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "noema-seed-inventory/v1"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "bytes",
            "sha256",
            "root"
          ],
          "properties": {
            "name": {
              "const": "noema-v0-evidence.zip"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "root": {
              "type": "string",
              "minLength": 2,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/$"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/seedFile"
          }
        }
      }
    },
    "moduleLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact\\.[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_sha256",
        "graph_sha256",
        "compiler_sha256",
        "kernel_sha256",
        "profile_sha256",
        "modules"
      ],
      "properties": {
        "schema": {
          "const": "noema-lock/v1"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compiler_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kernel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "modules": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleLock"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "evidence_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact\\.[0-9a-f]{64}$"
        },
        "value": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "fact",
        "evidence_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "reason": {
          "enum": [
            "not-reachable",
            "checked-false-guard",
            "checked-true-guard"
          ]
        },
        "fact": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^fact\\.[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "state",
        "target",
        "tools",
        "authority",
        "facts"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "tools": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "authority": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "graph_sha256",
        "lock_sha256",
        "compiler_sha256",
        "kernel_sha256",
        "profile_sha256",
        "selection",
        "selection_sha256",
        "facts_sha256",
        "included_ids",
        "omitted",
        "definitions",
        "literals",
        "tape",
        "tape_sha256",
        "projection_sha256",
        "artifacts"
      ],
      "properties": {
        "schema": {
          "const": "noema-manifest/v1"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compiler_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kernel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "selection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "facts_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "included_ids": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "omitted": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/omission"
          }
        },
        "definitions": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "literals": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "tape": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        },
        "tape_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "modules",
            "profile",
            "kernel",
            "selection",
            "projection"
          ],
          "properties": {
            "build": { "$ref": "#/$defs/artifactLeaf" },
            "modules": { "$ref": "#/$defs/artifactLeaf" },
            "profile": { "$ref": "#/$defs/artifactLeaf" },
            "kernel": { "$ref": "#/$defs/artifactLeaf" },
            "selection": { "$ref": "#/$defs/artifactLeaf" },
            "projection": { "$ref": "#/$defs/artifactLeaf" }
          }
        }
      }
    },
    "sliceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "graph_sha256",
        "profile_sha256",
        "selection_sha256",
        "aliases_sha256",
        "text"
      ],
      "properties": {
        "schema": { "const": "noema-slice-projection/v1" },
        "graph_sha256": { "$ref": "#/$defs/sha256" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "selection_sha256": { "$ref": "#/$defs/sha256" },
        "aliases_sha256": { "$ref": "#/$defs/sha256" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "digestSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archive": {
          "$ref": "#/$defs/sha256"
        },
        "inventory": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/sha256"
        },
        "graph": {
          "$ref": "#/$defs/sha256"
        },
        "build": {
          "$ref": "#/$defs/sha256"
        },
        "lock": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/sha256"
        },
        "kernel": {
          "$ref": "#/$defs/sha256"
        },
        "projection": {
          "$ref": "#/$defs/sha256"
        },
        "manifest": {
          "$ref": "#/$defs/sha256"
        },
        "output": {
          "$ref": "#/$defs/sha256"
        },
        "before": {
          "$ref": "#/$defs/sha256"
        },
        "after": {
          "$ref": "#/$defs/sha256"
        },
        "diff": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "countSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "members": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "modules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "aliases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "included": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "selectOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "manifest_sha256",
        "projection_sha256",
        "included_ids",
        "omitted_ids",
        "changed"
      ],
      "properties": {
        "schema": { "const": "noema-select/v1" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "included_ids": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nodeId" }
        },
        "omitted_ids": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nodeId" }
        },
        "changed": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "checkOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "decision",
        "effect",
        "consequence",
        "controlling_node",
        "reason"
      ],
      "properties": {
        "schema": { "const": "noema-check/v1" },
        "decision": { "enum": ["permit", "refuse", "unknown"] },
        "effect": { "$ref": "#/$defs/identifier" },
        "consequence": { "type": "integer", "minimum": 0, "maximum": 3 },
        "controlling_node": { "$ref": "#/$defs/nodeId" },
        "reason": {
          "enum": [
            "prohibition",
            "failed-requirement",
            "conflicting-requirements",
            "authority-mismatch",
            "invalid-exception",
            "unestablished-guard",
            "default-deny",
            "applicable-policy",
            "low-consequence-default",
            "no-applicable-policy"
          ]
        }
      }
    },
    "nextOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "transition",
        "state",
        "next_state",
        "effects",
        "controlling_node",
        "reason"
      ],
      "properties": {
        "schema": { "const": "noema-next/v1" },
        "status": { "enum": ["transition", "stop"] },
        "transition": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "state": { "$ref": "#/$defs/identifier" },
        "next_state": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "effects": {
          "type": "array",
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/term" }
        },
        "controlling_node": { "$ref": "#/$defs/nodeId" },
        "reason": {
          "enum": [
            "established-transition",
            "unestablished-guard",
            "no-enabled-transition"
          ]
        }
      }
    },
    "literalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "bytes", "sha256", "value"],
      "properties": {
        "schema": { "const": "noema-literal/v1" },
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["id", "path", "sha256", "command", "number", "date", "url", "quote", "text", "bytes"] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 65000 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "value": { "type": "string", "maxLength": 65000 }
      }
    },
    "explainOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authoritative", "node", "render"],
      "properties": {
        "schema": { "const": "noema-explanation/v1" },
        "authoritative": { "const": false },
        "node": { "$ref": "#/$defs/nodeId" },
        "render": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "runtimeOutput": {
      "oneOf": [
        { "$ref": "#/$defs/selectOutput" },
        { "$ref": "#/$defs/checkOutput" },
        { "$ref": "#/$defs/nextOutput" },
        { "$ref": "#/$defs/literalOutput" },
        { "$ref": "#/$defs/explainOutput" }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "command",
        "correlation_id",
        "verdict",
        "code",
        "digests",
        "counts"
      ],
      "properties": {
        "schema": {
          "const": "noema-result/v1"
        },
        "command": {
          "enum": [
            "invalid",
            "about",
            "verify-seed",
            "parse",
            "format",
            "project",
            "semantic-diff",
            "select",
            "check",
            "next",
            "literal",
            "explain",
            "verify",
            "mutations",
            "measure",
            "emit-evaluation",
            "tally-evaluation",
            "self-test",
            "runtime-self-test"
          ]
        },
        "correlation_id": {
          "$ref": "#/$defs/sha256"
        },
        "verdict": {
          "enum": [
            "ok",
            "refuse",
            "unknown"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^NOE-(OK|I-[A-Z0-9_.-]+|E-[A-Z0-9_.-]+)$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 640,
          "pattern": "^[A-Za-z0-9_.\u005b\u005d-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digests": {
          "$ref": "#/$defs/digestSet"
        },
        "counts": {
          "$ref": "#/$defs/countSet"
        },
        "output": {
          "$ref": "#/$defs/runtimeOutput"
        }
      }
    },
    "decimalString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "qualifiedIdentifier": {
      "allOf": [
        { "$ref": "#/$defs/identifier" },
        { "pattern": "\\." }
      ]
    },
    "parameter": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/identifier" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sourceBinding": {
      "type": "array",
      "prefixItems": [
        { "const": "src" },
        { "$ref": "#/$defs/relativePath" },
        { "$ref": "#/$defs/sha256" },
        { "$ref": "#/$defs/decimalString" },
        { "$ref": "#/$defs/decimalString" }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "term": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "const": "$" },
            { "$ref": "#/$defs/identifier" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "%" },
            { "$ref": "#/$defs/identifier" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": ":" },
            { "$ref": "#/$defs/identifier" },
            { "type": "string", "maxLength": 65000 }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "{}" },
            { "$ref": "#/$defs/identifier" }
          ],
          "items": { "$ref": "#/$defs/term" },
          "minItems": 2,
          "maxItems": 4098
        },
        {
          "type": "array",
          "prefixItems": [
            { "enum": ["!", "-", "+", "~", "count"] },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "enum": ["?", "/", "@", "^", "=", "=>", "<", "in", "subset", "lt", "le", "gt", "ge"] },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            { "enum": [";", "&", "|"] }
          ],
          "items": { "$ref": "#/$defs/term" },
          "minItems": 2,
          "maxItems": 16385
        },
        {
          "type": "array",
          "prefixItems": [
            { "enum": ["all", "any", "one"] },
            { "$ref": "#/$defs/parameter" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/qualifiedIdentifier" }
          ],
          "items": { "$ref": "#/$defs/term" },
          "minItems": 1,
          "maxItems": 65
        }
      ]
    },
    "sourceRecord": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "const": "import" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/sha256" }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "literal" },
            { "$ref": "#/$defs/identifier" },
            { "enum": ["id", "path", "sha256", "command", "number", "date", "url", "quote", "text", "bytes"] },
            { "$ref": "#/$defs/decimalString" },
            { "type": "string", "maxLength": 65000 }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "definition" },
            { "$ref": "#/$defs/qualifiedIdentifier" },
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/parameter" }
            },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "rule" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/sourceBinding" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "precedence" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 6,
          "maxItems": 6
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "override" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 7,
          "maxItems": 7
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "transition" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 8,
          "maxItems": 8
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "promise" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 11,
          "maxItems": 11
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "handoff" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 11,
          "maxItems": 11
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "exception" },
            { "$ref": "#/$defs/identifier" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 9,
          "maxItems": 9
        }
      ]
    },
    "typeDeclaration": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/qualifiedIdentifier" },
        { "$ref": "#/$defs/identifier" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "signature": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/qualifiedIdentifier" },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/identifier" }
        },
        { "$ref": "#/$defs/identifier" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "moduleDefinition": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/qualifiedIdentifier" },
        {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/parameter" }
        },
        { "$ref": "#/$defs/term" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "imports", "types", "signatures", "definitions"],
      "properties": {
        "schema": { "const": "noema-module/v1" },
        "id": { "$ref": "#/$defs/identifier" },
        "imports": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              { "$ref": "#/$defs/identifier" },
              { "$ref": "#/$defs/sha256" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "types": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/typeDeclaration" }
        },
        "signatures": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signature" }
        },
        "definitions": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleDefinition" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "alphabet", "tokenizer", "vocabulary_sha256", "kernel_sha256", "reserved", "aliases"],
      "properties": {
        "schema": { "const": "noema-profile/v1" },
        "id": { "$ref": "#/$defs/identifier" },
        "alphabet": { "const": "ascii-printable-v1" },
        "tokenizer": { "type": "string", "minLength": 1, "maxLength": 256 },
        "vocabulary_sha256": { "$ref": "#/$defs/sha256" },
        "kernel_sha256": { "$ref": "#/$defs/sha256" },
        "reserved": {
          "const": ["!", "$", "%", "&", "+", "-", "/", ":", ";", "<", "=", "=>", "?", "@", "NOE1", "NT1", "^", "all", "any", "count", "definition", "exception", "ge", "gt", "handoff", "import", "in", "le", "literal", "lt", "one", "override", "precedence", "promise", "rule", "src", "subset", "transition", "{}", "|", "~"]
        },
        "aliases": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "minLength": 1, "maxLength": 128 },
              { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9!#$%&*+./:<=>?@^_|~-]+$" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "graphModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "value": { "$ref": "#/$defs/module" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_sha256", "records", "modules"],
      "properties": {
        "schema": { "const": "noema-graph/v1" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "records": { "type": "array", "maxItems": 16384, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRecord" } },
        "modules": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/graphModule" } }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "graph", "lock"],
      "properties": {
        "schema": { "const": "noema-build/v1" },
        "graph": { "$ref": "#/$defs/graph" },
        "lock": { "$ref": "#/$defs/lock" }
      }
    },
    "projectionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "graph_sha256", "lock_sha256", "profile_sha256", "aliases_sha256", "projection_sha256"],
      "properties": {
        "schema": { "const": "noema-projection-manifest/v1" },
        "graph_sha256": { "$ref": "#/$defs/sha256" },
        "lock_sha256": { "$ref": "#/$defs/sha256" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "aliases_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "lock", "manifest", "text"],
      "properties": {
        "schema": { "const": "noema-projection/v1" },
        "lock": { "$ref": "#/$defs/lock" },
        "manifest": { "$ref": "#/$defs/projectionManifest" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "diffEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "kind", "change", "before", "after"],
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 268 },
        "kind": { "enum": ["effect", "gate", "authority", "scope", "evidence_class", "literal", "transition", "precedence", "source_binding", "definition", "module", "promise", "handoff", "exception"] },
        "change": { "enum": ["added", "removed", "modified"] },
        "before": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "semanticDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "before_graph_sha256", "after_graph_sha256", "entries"],
      "properties": {
        "schema": { "const": "noema-semantic-diff/v1" },
        "before_graph_sha256": { "$ref": "#/$defs/sha256" },
        "after_graph_sha256": { "$ref": "#/$defs/sha256" },
        "entries": { "type": "array", "maxItems": 65536, "uniqueItems": true, "items": { "$ref": "#/$defs/diffEntry" } }
      }
    },
    "profileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "identity",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "family": {
          "enum": [
            "openai",
            "anthropic",
            "google",
            "open-weight"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "measured",
            "recorded",
            "unknown"
          ]
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vocabulary_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "tree_sha256",
        "manifest_sha256",
        "status",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "noema-evidence/v1"
        },
        "kind": {
          "enum": [
            "measurement",
            "evaluation"
          ]
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "measured",
            "recorded",
            "unknown"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileEvidence"
          }
        }
      }
    }
  }
}
