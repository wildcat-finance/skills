{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/shoggoth-demonstration-v1.json",
  "title": "Shoggoth demonstration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "plugin",
    "status",
    "claim_id",
    "claim",
    "non_claim",
    "network",
    "timeout_seconds",
    "sources",
    "commands",
    "observations",
    "frontier"
  ],
  "properties": {
    "schema": {"const": "shoggoth-demonstration/v1"},
    "skill": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "plugin": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "status": {
      "enum": ["real-data", "mixed", "constructed", "absent", "not-applicable"]
    },
    "claim_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
    "non_claim": {"type": "string", "minLength": 1, "maxLength": 4096},
    "network": {"$ref": "#/$defs/network"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/fileSource"},
          {"$ref": "#/$defs/chainSource"}
        ]
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/command"}
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "frontier": {"$ref": "#/$defs/frontier"}
  },
  "$defs": {
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"enum": ["denied", "allowlisted"]},
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "pattern": "^https://", "maxLength": 2048}
        },
        "secret_env": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        }
      }
    },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "class": {
          "enum": ["protocol", "repository", "audit", "production-run", "fixture", "model-record"]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "chainSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "chain", "block", "anchor"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "class": {"const": "chain"},
        "chain": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "block": {"type": "integer", "minimum": 0},
        "anchor": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "expect_exit"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "revision", "sha256", "current", "next"],
      "properties": {
        "version": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}-demo-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["open", "mature"]},
        "revision": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current": {"type": "string", "minLength": 1, "maxLength": 4096},
        "next": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
