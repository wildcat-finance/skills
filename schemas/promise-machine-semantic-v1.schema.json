{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/promise-machine-semantic-v1.schema.json",
  "title": "Promise Machine semantic records v1",
  "oneOf": [
    {"$ref": "#/$defs/transition"},
    {"$ref": "#/$defs/declaration"},
    {"$ref": "#/$defs/authority"},
    {"$ref": "#/$defs/exception"},
    {"$ref": "#/$defs/exceptionSpecimen"},
    {"$ref": "#/$defs/findingSpecimen"},
    {"$ref": "#/$defs/importSpecimen"}
  ],
  "$defs": {
    "promiseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmpty"},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "promise_id",
        "gate",
        "consequence",
        "subject",
        "scope",
        "transition"
      ],
      "properties": {
        "schema": {"const": "promise-machine-transition-declaration/v1"},
        "promise_id": {"$ref": "#/$defs/promiseId"},
        "gate": {"$ref": "#/$defs/nonEmpty"},
        "consequence": {"type": "integer", "minimum": 0, "maximum": 3},
        "subject": {"$ref": "#/$defs/nonEmpty"},
        "scope": {"$ref": "#/$defs/nonEmpty"},
        "transition": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "promise_id", "gate", "subject", "scope"],
      "properties": {
        "schema": {"const": "promise-machine-transition-authority/v1"},
        "id": {"$ref": "#/$defs/nonEmpty"},
        "promise_id": {"$ref": "#/$defs/promiseId"},
        "gate": {"$ref": "#/$defs/nonEmpty"},
        "subject": {"$ref": "#/$defs/nonEmpty"},
        "scope": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "class",
        "status",
        "reference",
        "subject",
        "scope",
        "independent"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/nonEmpty"},
        "class": {
          "enum": [
            "checked",
            "recomputed",
            "proved",
            "measured",
            "recorded",
            "attested",
            "inferred",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "checked",
            "recomputed",
            "proved",
            "measured",
            "recorded",
            "attested",
            "inferred",
            "unknown",
            "not-run",
            "missing",
            "stale"
          ]
        },
        "reference": {"$ref": "#/$defs/reference"},
        "subject": {"$ref": "#/$defs/nonEmpty"},
        "scope": {"$ref": "#/$defs/nonEmpty"},
        "independent": {"type": "boolean"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "promise_id",
        "obligation_id",
        "gate",
        "consequence",
        "subject",
        "scope",
        "transition",
        "evaluated_at",
        "declaration",
        "evidence",
        "unknowns",
        "authority",
        "exception"
      ],
      "properties": {
        "schema": {"const": "promise-machine-transition/v1"},
        "promise_id": {"$ref": "#/$defs/promiseId"},
        "obligation_id": {"$ref": "#/$defs/promiseId"},
        "gate": {"$ref": "#/$defs/nonEmpty"},
        "consequence": {"type": "integer", "minimum": 0, "maximum": 3},
        "subject": {"$ref": "#/$defs/nonEmpty"},
        "scope": {"$ref": "#/$defs/nonEmpty"},
        "transition": {"$ref": "#/$defs/nonEmpty"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "declaration": {"$ref": "#/$defs/reference"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "unknowns": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "authority": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reference"}
          ]
        },
        "exception": {
          "oneOf": [
            {"const": "none"},
            {"$ref": "#/$defs/reference"}
          ]
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "authority",
        "promise_id",
        "gate",
        "subject",
        "scope",
        "record",
        "expiry",
        "revoked",
        "recovery"
      ],
      "properties": {
        "schema": {"const": "promise-machine-exception/v1"},
        "id": {"$ref": "#/$defs/nonEmpty"},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "reference"],
          "properties": {
            "id": {"$ref": "#/$defs/nonEmpty"},
            "reference": {"$ref": "#/$defs/reference"}
          }
        },
        "promise_id": {"$ref": "#/$defs/promiseId"},
        "gate": {"$ref": "#/$defs/nonEmpty"},
        "subject": {"$ref": "#/$defs/nonEmpty"},
        "scope": {"$ref": "#/$defs/nonEmpty"},
        "record": {"$ref": "#/$defs/reference"},
        "expiry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at"],
              "properties": {"at": {"$ref": "#/$defs/timestamp"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["not_applicable"],
              "properties": {
                "not_applicable": {"$ref": "#/$defs/nonEmpty"}
              }
            }
          ]
        },
        "revoked": {"type": "boolean"},
        "recovery": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "fault",
        "path",
        "message",
        "remedy",
        "promise_id",
        "obligation_id",
        "consequence",
        "blocked_transition",
        "recovery"
      ],
      "properties": {
        "code": {"type": "string", "pattern": "^PM[0-9]{3}$"},
        "fault": {"$ref": "#/$defs/nonEmpty"},
        "path": {"$ref": "#/$defs/nonEmpty"},
        "message": {"$ref": "#/$defs/nonEmpty"},
        "remedy": {"$ref": "#/$defs/nonEmpty"},
        "promise_id": {"$ref": "#/$defs/promiseId"},
        "obligation_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/promiseId"}
          ]
        },
        "consequence": {"type": "integer", "minimum": 0, "maximum": 3},
        "blocked_transition": {"$ref": "#/$defs/nonEmpty"},
        "recovery": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "exceptionSpecimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "evaluated_at", "expected", "exception"],
      "properties": {
        "schema": {"const": "promise-machine-exception-specimen/v1"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promise_id",
            "gate",
            "subject",
            "scope",
            "consequence",
            "transition"
          ],
          "properties": {
            "promise_id": {"$ref": "#/$defs/promiseId"},
            "gate": {"$ref": "#/$defs/nonEmpty"},
            "subject": {"$ref": "#/$defs/nonEmpty"},
            "scope": {"$ref": "#/$defs/nonEmpty"},
            "consequence": {"type": "integer", "minimum": 0, "maximum": 3},
            "transition": {"$ref": "#/$defs/nonEmpty"}
          }
        },
        "exception": {"$ref": "#/$defs/exception"}
      }
    },
    "findingSpecimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "finding"],
      "properties": {
        "schema": {"const": "promise-machine-finding-specimen/v1"},
        "finding": {"type": "object"}
      }
    },
    "importSpecimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source"],
      "properties": {
        "schema": {"const": "promise-machine-import-specimen/v1"},
        "source": {"type": "string"}
      }
    }
  }
}
