{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.wildcat.finance/grounded-agent/v1/schema.json",
  "title": "Ariadne grounded-agent predicate v1",
  "description": "The https://ariadne.wildcat.finance/grounded-agent/v1 predicate binds a berean-release/v1 identity and its exact byte subjects without projecting evaluation conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "given",
    "produced",
    "policy",
    "adapter",
    "comparison",
    "claims",
    "commands"
  ],
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "release_version",
        "release_digest",
        "document"
      ],
      "properties": {
        "format": {
          "const": "berean-release/v1"
        },
        "release_version": {
          "$ref": "#/$defs/portableName"
        },
        "release_digest": {
          "$ref": "#/$defs/sha256"
        },
        "document": {
          "$ref": "#/$defs/component"
        }
      }
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "reads",
        "reads_absence_reason"
      ],
      "properties": {
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "corpus_version",
            "corpus_digest",
            "manifest",
            "components"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "corpus_version": {
              "$ref": "#/$defs/portableName"
            },
            "corpus_digest": {
              "$ref": "#/$defs/sha256"
            },
            "manifest": {
              "$ref": "#/$defs/component"
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/component"
              }
            }
          }
        },
        "reads": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "chain_id",
                "block_number",
                "block_hash",
                "source"
              ],
              "properties": {
                "component": {
                  "$ref": "#/$defs/component"
                },
                "chain_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "block_number": {
                  "type": "integer",
                  "minimum": 0
                },
                "block_hash": {
                  "$ref": "#/$defs/hash32"
                },
                "source": {
                  "$ref": "#/$defs/stated"
                }
              }
            }
          ]
        },
        "reads_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reads": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "reads_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reads": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "reads_absence_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "produced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers",
        "evaluations",
        "evaluations_absence_reason",
        "promotion",
        "promotion_absence_reason"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "evaluations": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cases",
                "report"
              ],
              "properties": {
                "cases": {
                  "$ref": "#/$defs/component"
                },
                "report": {
                  "$ref": "#/$defs/component"
                }
              }
            }
          ]
        },
        "evaluations_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        },
        "promotion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "format",
                "terminal"
              ],
              "properties": {
                "component": {
                  "$ref": "#/$defs/component"
                },
                "format": {
                  "const": "berean-promotion/v1"
                },
                "terminal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sequence",
                    "action",
                    "target_release_digest"
                  ],
                  "properties": {
                    "sequence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "action": {
                      "enum": [
                        "promote",
                        "rollback"
                      ]
                    },
                    "target_release_digest": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "action": {
                            "const": "rollback"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "sequence": {
                            "minimum": 2
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "promotion_absence_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluations": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluations": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations_absence_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "promotion_absence_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "promotion_absence_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "promotion": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "evaluations": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_families",
        "refusal_conditions",
        "rules",
        "allowlists",
        "retention"
      ],
      "properties": {
        "question_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "refusal_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_classes",
            "evidence_classes"
          ],
          "properties": {
            "source_classes": {
              "const": [
                "document",
                "chain_read",
                "calculation",
                "user_supplied"
              ]
            },
            "evidence_classes": {
              "const": [
                "proof-backed",
                "header-bound",
                "recorded-rpc"
              ]
            }
          }
        },
        "allowlists": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chains",
            "contracts"
          ],
          "properties": {
            "chains": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "contracts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 42,
                "maxLength": 42,
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        "retention": {
          "enum": [
            "none",
            "answers-only"
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "command",
        "parameters_digest"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/portableName"
        },
        "tool_version": {
          "$ref": "#/$defs/portableName"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/stated"
          }
        },
        "parameters_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "current",
        "first_capture_reason"
      ],
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/comparisonSide"
            }
          ]
        },
        "current": {
          "$ref": "#/$defs/comparisonSide"
        },
        "first_capture_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stated"
            }
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "subject",
          "disposition"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/portableName"
          },
          "subject": {
            "$ref": "#/$defs/digest"
          },
          "disposition": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "timed_out",
              "redacted"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 4096
          },
          "detail": {
            "allOf": [
              {
                "type": "object"
              },
              {
                "$ref": "#/$defs/noBereanResults"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "failed",
                    "skipped",
                    "timed_out",
                    "redacted"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "$ref": "#/$defs/stated"
                }
              }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv",
          "determinism"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/portableName"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/stated"
            }
          },
          "determinism": {
            "enum": [
              "exact",
              "nondeterministic"
            ]
          },
          "output_digest": {
            "$ref": "#/$defs/digest"
          },
          "detail": {
            "allOf": [
              {
                "type": "object"
              },
              {
                "$ref": "#/$defs/noBereanResults"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "determinism": {
                  "const": "exact"
                }
              }
            },
            "then": {
              "required": [
                "output_digest"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparison": {
            "properties": {
              "baseline": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "first_capture_reason": {
                "$ref": "#/$defs/stated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "comparison": {
            "properties": {
              "baseline": {
                "type": "object"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "first_capture_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash32": {
      "type": "string",
      "minLength": 66,
      "maxLength": 66,
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "stated": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u001f\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "portableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*[!-~])(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff])\\S(?:.*\\S)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![^/\\\\]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\s)(?!.*\\/\\s)(?!.*\\s(?:\\/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff])(?=[^/\\\\]*[!-.0-\\[\\]-~])[^\\u0000/\\\\]+(?:/(?=[^/\\\\]*[!-.0-\\[\\]-~])[^\\u0000/\\\\]+)*$"
    },
    "digest": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "enum": [
            "thresholds",
            "cases",
            "passed",
            "failed",
            "failures",
            "failures_allowed"
          ]
        }
      },
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha384": {
          "type": "string",
          "minLength": 96,
          "maxLength": 96,
          "pattern": "^[0-9a-f]{96}$"
        },
        "sha512": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]+$",
        "not": {
          "pattern": "[^0-9a-f]"
        }
      },
      "anyOf": [
        {
          "required": [
            "sha256"
          ]
        },
        {
          "required": [
            "sha384"
          ]
        },
        {
          "required": [
            "sha512"
          ]
        }
      ]
    },
    "noBereanResults": {
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "propertyNames": {
              "not": {
                "enum": [
                  "thresholds",
                  "cases",
                  "passed",
                  "failed",
                  "failures",
                  "failures_allowed"
                ]
              }
            },
            "additionalProperties": {
              "$ref": "#/$defs/noBereanResults"
            }
          }
        },
        {
          "if": {
            "type": "array"
          },
          "then": {
            "items": {
              "$ref": "#/$defs/noBereanResults"
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/portableName"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        }
      }
    },
    "comparisonSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "release_digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/portableName"
        },
        "release_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
