{
  "candidates": [
    {
      "id": "release-policy-scope",
      "summary": "Declare `scope` as a required closed object in the curation policy, the policy the release manifest records and release_id already hashes; admit-seed and release check the admitted sources and record count against it; the pilot declares its scope and is re-released; a second corpus declares its own."
    },
    {
      "id": "admission-policy-scope",
      "summary": "Declare `scope` in the admission policy (anamnesis-pilot-policy/v1) and extend release_id to hash that policy's canonical bytes; the pilot's events, release and projections all change and verify needs a document the release does not carry."
    },
    {
      "id": "permanent-seed-record",
      "summary": "Change no code. A decision record states that the hand-picked 41-record seed is the permanent shape of the corpus and names what governs additions; the record bound stays in seed_scope."
    },
    {
      "id": "widen-constant",
      "summary": "Keep seed_scope as a resolver-side constant and widen it, or add a second constant, so the estate corpus passes admit-seed; the release id stays a function of the curation policy alone."
    }
  ],
