    {
      "id": "registry-and-synopsis-mapper",
      "summary": "Resolve the policy's mapper through a name-and-version registry, ship a second implementation for fiat-audit-synopsis/v1, and admit the three committed synopses as a third corpus."
    },
    {
      "id": "registry-and-red-team-mapper",
      "summary": "Resolve through the same registry, but ship the second implementation for the external red-team FINDING block and admit that one preserved record."
    },
    {
      "id": "registry-only",
      "summary": "Resolve through the registry and refuse an unknown mapper, shipping no second implementation and no third corpus."
    },
    {
      "id": "per-source-mapper",
      "summary": "Move the mapper declaration from the curation policy to each admitted source, resolved through the registry, so one corpus can mix formats."
    }
