{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/alexandria/interval-plan-v1.schema.json",
  "title": "Alexandria chain interval plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "chain", "venue", "deployment", "proxy", "interval", "shard_width", "shards", "evidence_classes", "finality"],
  "properties": {
    "format": {"const": "alexandria-interval-plan/v1"},
    "chain": {"type": "string", "pattern": "^eip155:(0|[1-9][0-9]*)$"},
    "venue": {"$ref": "#/$defs/name"},
    "deployment": {"$ref": "#/$defs/name"},
    "proxy": {"$ref": "#/$defs/address"},
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/block"}, "end": {"$ref": "#/$defs/block"}}
    },
    "shard_width": {"type": "integer", "minimum": 1, "maximum": 50000},
    "shards": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/shard"}},
    "evidence_classes": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "finality": {"$ref": "#/$defs/finality"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "block": {"type": "string", "maxLength": 19, "pattern": "^(0|[1-9][0-9]*)$"},
    "shard": {
      "type": "object", "additionalProperties": false, "required": ["index", "start", "end"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "finality": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["policy", "block_number", "block_hash"],
          "properties": {
            "policy": {"enum": ["finalized", "safe"]},
            "block_number": {"$ref": "#/$defs/block"},
            "block_hash": {"$ref": "#/$defs/hash"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["policy", "confirmations", "block_number", "block_hash"],
          "properties": {
            "policy": {"const": "confirmations"},
            "confirmations": {"type": "integer", "minimum": 1},
            "block_number": {"$ref": "#/$defs/block"},
            "block_hash": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    }
  }
}
