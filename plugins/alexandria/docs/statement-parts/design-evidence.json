  "candidates": [
    {
      "id": "statement-parts",
      "summary": "Today's statement for a release within 8,388,608 bytes and 262,144 key characters; otherwise --parts writes index.json and part-NNNNN.json, greedy runs of components in manifest order, each part within 6,225,920 bytes and 262,144 key characters, the index binding every part by SHA-256. Ariadne is unchanged."
    },
    {
      "id": "per-component-statements",
      "summary": "The same part and index shapes with exactly one component a part, so a release past the single bounds gets one part per component and an index of up to 16,385 subjects."
    },
    {
      "id": "raised-limit-matched-reader",
      "summary": "One statement up to 134,217,728 bytes, read with ariadne.py verify --max-bytes 134217728, with Ariadne's aggregate key budget raised to 8,388,608 characters."
    },
    {
      "id": "compact-projection",
      "summary": "Today's statement within 8 MiB; otherwise one alexandria-release/v2 statement whose components and captures are arrays, keeping each capture's scope and coverage objects."
    }
