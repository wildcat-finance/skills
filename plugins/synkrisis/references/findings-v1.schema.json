{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildcat-finance/skills/plugins/synkrisis/references/findings-v1.schema.json",
  "title": "Synkrisis findings v1",
  "description": "Candidate findings recomputed from one checked cohort under one digest-bound rule catalogue. A finding is a bounded inferred relation: it names its runs and events, its counterevidence and unknowns, the nearest claim it refuses to make, and one suggested handoff a person may act on. It never carries a cause, a model judgement or an action.",
  "type": "object",
  "required": ["schema", "policy_name", "cohort_digest", "rules_digest", "findings", "refused_rules"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "synkrisis-findings/v1"},
    "policy_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "cohort_digest": {"$ref": "#/$defs/digest"},
    "rules_digest": {"$ref": "#/$defs/digest"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "rule_id",
          "rule_digest",
          "subject",
          "observed_relation",
          "evidence_class",
          "matched_runs",
          "counterevidence",
          "unknown_runs",
          "nearest_forbidden_claim",
          "handoff"
        ],
        "additionalProperties": false,
        "properties": {
          "fingerprint": {"$ref": "#/$defs/digest"},
          "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}/v[0-9]{1,4}$"},
          "rule_digest": {"$ref": "#/$defs/digest"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 4096},
          "observed_relation": {"type": "string", "minLength": 1, "maxLength": 4096},
          "evidence_class": {"const": "inferred"},
          "matched_runs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["run_id", "events"],
              "additionalProperties": false,
              "properties": {
                "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "events": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1, "maxLength": 128}
                }
              }
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["note"],
              "properties": {"note": {"type": "string", "minLength": 1, "maxLength": 4096}}
            }
          },
          "unknown_runs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "nearest_forbidden_claim": {"type": "string", "minLength": 1, "maxLength": 4096},
          "handoff": {
            "type": "object",
            "required": ["to", "reason"],
            "additionalProperties": false,
            "properties": {
              "to": {
                "enum": [
                  "ephoros",
                  "metron",
                  "elenchus",
                  "protasis",
                  "phylax",
                  "horos",
                  "human-review"
                ]
              },
              "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    },
    "refused_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "reason_code"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason_code": {
            "enum": [
              "missing-required-dimension",
              "below-minimum-samples",
              "relation-not-met",
              "token-accounting-not-comparable",
              "over-event-reference-ceiling"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
