{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildcat-finance/skills/plugins/synkrisis/references/policy-v1.schema.json",
  "title": "Synkrisis comparison policy v1",
  "description": "Operator-declared comparability for one cohort. Every run-context dimension is classified explicitly: match with an expected value, or differ. The policy records a declaration; Synkrisis checks it and does not infer that unlike tasks, models, hosts, repositories or tokenizers are comparable.",
  "type": "object",
  "required": ["schema", "name", "dimensions", "token_accounting"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "synkrisis-policy/v1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "dimensions": {
      "type": "object",
      "required": [
        "context.issue_or_topic",
        "context.promise_id",
        "context.role",
        "context.selected_skill",
        "context.step"
      ],
      "additionalProperties": false,
      "properties": {
        "context.issue_or_topic": {"$ref": "#/$defs/dimension"},
        "context.promise_id": {"$ref": "#/$defs/dimension"},
        "context.role": {"$ref": "#/$defs/dimension"},
        "context.selected_skill": {"$ref": "#/$defs/dimension"},
        "context.step": {"$ref": "#/$defs/dimension"}
      }
    },
    "token_accounting": {"enum": ["require-equal", "ignore"]}
  },
  "$defs": {
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "required": ["rule", "value"],
          "additionalProperties": false,
          "properties": {
            "rule": {"const": "match"},
            "value": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "required": ["rule"],
          "additionalProperties": false,
          "properties": {"rule": {"const": "differ"}}
        }
      ]
    }
  }
}
