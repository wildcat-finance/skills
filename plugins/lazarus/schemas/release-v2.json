{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazarus.wildcat.finance/schemas/release-v2.json",
  "title": "Lazarus preservation release v2",
  "description": "A manifest-v2 fixture bound to a state-fixture/v2 statement. The receipt-trie count covers only the scoped consensus receipt and log-projection relations; transaction-hash attribution is not part of this format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "fixture",
    "statement",
    "verified",
    "binding",
    "release_digest"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fixture_digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "fixture_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "statement": {
      "type": "object",
      "description": "The exact statement bytes and their explicitly versioned predicate type.",
      "additionalProperties": false,
      "required": ["path", "sha256", "predicate_type"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "predicate_type": {
          "const": "https://ariadne.wildcat.finance/state-fixture/v2"
        }
      }
    },
    "verified": {
      "type": "object",
      "description": "Values recomputed by offline fixture verification rather than copied from the manifest.",
      "additionalProperties": false,
      "required": [
        "block_hash",
        "receipts_root",
        "evidence_counts",
        "canonical_chain_claim"
      ],
      "properties": {
        "block_hash": {"$ref": "#/$defs/hash32"},
        "receipts_root": {"$ref": "#/$defs/nonzero_hash32"},
        "evidence_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proof_backed",
            "header_bound",
            "recorded_rpc",
            "receipt_trie_proved"
          ],
          "properties": {
            "proof_backed": {"$ref": "#/$defs/count"},
            "header_bound": {"$ref": "#/$defs/count"},
            "recorded_rpc": {"$ref": "#/$defs/count"},
            "receipt_trie_proved": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "description": "Only the consensus receipt and log-projection relations proved by the receipt witness."
            }
          }
        },
        "canonical_chain_claim": {
          "const": false,
          "description": "A verified header and receipt trie do not establish canonical-chain placement."
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        }
      }
    },
    "release_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "nonzero_hash32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    }
  }
}
