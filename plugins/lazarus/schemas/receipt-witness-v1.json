{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazarus.wildcat.finance/schemas/receipt-witness-v1.json",
  "title": "Lazarus ordered receipt witness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "header",
    "receipts",
    "target_receipt",
    "filtered_logs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "hash",
        "receipts_root"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/quantity"
        },
        "hash": {
          "$ref": "#/$defs/hash32"
        },
        "receipts_root": {
          "$ref": "#/$defs/hash32"
        }
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "target_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_index"
      ],
      "properties": {
        "transaction_index": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "filtered_logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter"
      ],
      "properties": {
        "filter": {
          "$ref": "#/$defs/log_filter"
        }
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "string",
      "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,63})$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})*$",
      "maxLength": 131074
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "bloom": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{512}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_index",
        "receipt_type",
        "cumulative_gas_used",
        "logs_bloom",
        "logs"
      ],
      "properties": {
        "transaction_index": {
          "$ref": "#/$defs/quantity"
        },
        "receipt_type": {
          "enum": [
            "legacy",
            "0x1",
            "0x2",
            "0x3",
            "0x4"
          ]
        },
        "status": {
          "enum": [
            "0x0",
            "0x1"
          ]
        },
        "root": {
          "$ref": "#/$defs/hash32"
        },
        "cumulative_gas_used": {
          "$ref": "#/$defs/quantity"
        },
        "logs_bloom": {
          "$ref": "#/$defs/bloom"
        },
        "logs": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/log"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "status"
          ],
          "not": {
            "required": [
              "root"
            ]
          }
        },
        {
          "required": [
            "root"
          ],
          "not": {
            "required": [
              "status"
            ]
          }
        }
      ]
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "topics",
        "data"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "topics": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/hash32"
          }
        },
        "data": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "log_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockHash"
      ],
      "properties": {
        "blockHash": {
          "$ref": "#/$defs/hash32"
        },
        "address": {
          "oneOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/address"
              }
            }
          ]
        },
        "topics": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/hash32"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/hash32"
                }
              }
            ]
          }
        }
      }
    }
  }
}
