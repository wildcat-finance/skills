{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazarus.wildcat.finance/schemas/manifest-v2.json",
  "title": "Lazarus receipt-proof fixture manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "chain_id", "block", "receipts_root", "components", "evidence_counts", "optional_failures", "fixture_digest"],
  "properties": {
    "schema_version": {"const": 2},
    "tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chain_id": {"const": "0x1"},
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "hash"],
      "properties": {
        "number": {"$ref": "#/$defs/quantity"},
        "hash": {"$ref": "#/$defs/hash32"}
      }
    },
    "receipts_root": {"$ref": "#/$defs/hash32"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_backed", "header_bound", "recorded_rpc", "receipt_trie_proved"],
      "properties": {
        "proof_backed": {"type": "integer", "minimum": 0, "maximum": 100000},
        "header_bound": {"type": "integer", "minimum": 0, "maximum": 100000},
        "recorded_rpc": {"type": "integer", "minimum": 0, "maximum": 100000},
        "receipt_trie_proved": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "optional_failures": {
      "type": "array",
      "maxItems": 100000,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "quantity": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,63})$"},
    "hash32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}
