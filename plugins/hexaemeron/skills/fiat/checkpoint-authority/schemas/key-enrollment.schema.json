{
  "$id": "https://wildcat.finance/attestations/checkpoint-authority/v1/key-enrollment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "environment": {
      "enum": [
        "test",
        "production"
      ]
    },
    "issued_at": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "type": "string"
    },
    "issuer": {
      "oneOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}(?![\\s\\S])",
          "type": "string"
        },
        {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9A-F]{40}(?![\\s\\S])",
          "type": "string"
        }
      ]
    },
    "key": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "enum": [
                "ecdsa-p256-sha256"
              ]
            },
            "fingerprint": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            },
            "format": {
              "enum": [
                "spki-p256"
              ]
            },
            "public": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "format",
            "algorithm",
            "public",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "enum": [
                "ed25519"
              ]
            },
            "fingerprint": {
              "maxLength": 50,
              "minLength": 1,
              "pattern": "^SHA256:[A-Za-z0-9+/]{43}(?![\\s\\S])",
              "type": "string"
            },
            "format": {
              "enum": [
                "ssh-ed25519"
              ]
            },
            "public": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "format",
            "algorithm",
            "public",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "enum": [
                "ecdsa-p256-sha256"
              ]
            },
            "fingerprint": {
              "maxLength": 50,
              "minLength": 1,
              "pattern": "^SHA256:[A-Za-z0-9+/]{43}(?![\\s\\S])",
              "type": "string"
            },
            "format": {
              "enum": [
                "ssh-p256"
              ]
            },
            "public": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "format",
            "algorithm",
            "public",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "enum": [
                "openpgp"
              ]
            },
            "fingerprint": {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[0-9A-F]{40}(?![\\s\\S])",
              "type": "string"
            },
            "format": {
              "enum": [
                "openpgp-v4"
              ]
            },
            "public": {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "format",
            "algorithm",
            "public",
            "fingerprint"
          ],
          "type": "object"
        }
      ]
    },
    "not_after": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "type": "string"
    },
    "not_before": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "type": "string"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        "type": {
          "enum": [
            "authority-policy"
          ]
        }
      },
      "required": [
        "type",
        "sha256"
      ],
      "type": "object"
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            },
            "type": {
              "enum": [
                "authority-policy",
                "enrollment-challenge",
                "key-enrollment",
                "key-rotation",
                "key-revocation",
                "run-grant",
                "run-registration",
                "upload-endorsement",
                "validation",
                "storage-copy",
                "parent-link",
                "acceptance",
                "cancellation",
                "publication-finalization",
                "denial",
                "authorized-removal",
                "journal-entry",
                "authority-head",
                "stream-permit"
              ]
            }
          },
          "required": [
            "type",
            "sha256"
          ],
          "type": "object"
        }
      ]
    },
    "proof": {
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            },
            "type": {
              "enum": [
                "enrollment-challenge"
              ]
            }
          },
          "required": [
            "type",
            "sha256"
          ],
          "type": "object"
        },
        "signature": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "challenge",
        "signature"
      ],
      "type": "object"
    },
    "protocol": {
      "enum": [
        "checkpoint-authority/v1"
      ]
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "run_id"
      ],
      "type": "object"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "service": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "type": {
      "enum": [
        "key-enrollment"
      ]
    }
  },
  "required": [
    "protocol",
    "environment",
    "service",
    "scope",
    "type",
    "sequence",
    "previous",
    "issued_at",
    "issuer",
    "policy",
    "actor_id",
    "key",
    "proof",
    "not_before",
    "not_after"
  ],
  "type": "object"
}
