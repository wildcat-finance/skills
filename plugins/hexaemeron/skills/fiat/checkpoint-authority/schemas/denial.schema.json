{
  "$id": "https://wildcat.finance/attestations/checkpoint-authority/v1/denial",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "descendants": {
      "enum": [
        "poison",
        "none"
      ]
    },
    "effective_at": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "type": "string"
    },
    "environment": {
      "enum": [
        "test",
        "production"
      ]
    },
    "issued_at": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "type": "string"
    },
    "issuer": {
      "oneOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}(?![\\s\\S])",
          "type": "string"
        },
        {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9A-F]{40}(?![\\s\\S])",
          "type": "string"
        }
      ]
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        "type": {
          "enum": [
            "authority-policy"
          ]
        }
      },
      "required": [
        "type",
        "sha256"
      ],
      "type": "object"
    },
    "policy_head": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        "type": {
          "enum": [
            "authority-head"
          ]
        }
      },
      "required": [
        "type",
        "sha256"
      ],
      "type": "object"
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            },
            "type": {
              "enum": [
                "authority-policy",
                "enrollment-challenge",
                "key-enrollment",
                "key-rotation",
                "key-revocation",
                "run-grant",
                "run-registration",
                "upload-endorsement",
                "validation",
                "storage-copy",
                "parent-link",
                "acceptance",
                "cancellation",
                "publication-finalization",
                "denial",
                "authorized-removal",
                "journal-entry",
                "authority-head",
                "stream-permit"
              ]
            }
          },
          "required": [
            "type",
            "sha256"
          ],
          "type": "object"
        }
      ]
    },
    "protocol": {
      "enum": [
        "checkpoint-authority/v1"
      ]
    },
    "reason": {
      "enum": [
        "compromise",
        "invalid-evidence",
        "operator-revoked",
        "poisoned-ancestor"
      ]
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "run_id"
      ],
      "type": "object"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "service": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "target": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "snapshot"
              ]
            },
            "snapshot_id": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "snapshot_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "representation"
              ]
            },
            "outer_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "outer_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "run"
              ]
            },
            "run_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "run_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "enrollment": {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "key-enrollment",
                    "key-rotation"
                  ]
                }
              },
              "required": [
                "type",
                "sha256"
              ],
              "type": "object"
            },
            "kind": {
              "enum": [
                "key"
              ]
            }
          },
          "required": [
            "kind",
            "enrollment"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "enum": [
        "denial"
      ]
    }
  },
  "required": [
    "protocol",
    "environment",
    "service",
    "scope",
    "type",
    "sequence",
    "previous",
    "issued_at",
    "issuer",
    "policy",
    "target",
    "reason",
    "descendants",
    "effective_at",
    "policy_head"
  ],
  "type": "object"
}
