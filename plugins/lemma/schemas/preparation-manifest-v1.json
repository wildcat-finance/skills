{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "request_sha256",
    "original_sha256",
    "prepared_sha256",
    "target",
    "sources",
    "reverse_map",
    "removed",
    "selected",
    "excluded",
    "transcripts"
  ],
  "properties": {
    "schema": {
      "const": "lemma-preparation-manifest/v1"
    },
    "request": {
      "$ref": "preparation-request-v1.json"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prepared_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "contract"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original",
          "prepared",
          "sha256",
          "selected"
        ],
        "properties": {
          "original": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "prepared": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "selected": {
            "type": "boolean"
          }
        }
      }
    },
    "reverse_map": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "removed": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "selected": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "transcripts": {
      "type": "array",
      "maxItems": 65,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output",
          "input_sha256",
          "output_sha256"
        ],
        "properties": {
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  }
}
