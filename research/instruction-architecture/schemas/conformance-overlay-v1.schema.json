{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/instruction-architecture/conformance-overlay-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "base": {"$ref": "#/$defs/digestedPath"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate": {"$ref": "#/$defs/id"},
          "command": {"maxLength": 4096, "minLength": 1, "type": "string"},
          "criterion": {"$ref": "#/$defs/id"},
          "evidence_path": {"$ref": "#/$defs/path"},
          "evidence_sha256": {"$ref": "#/$defs/sha256"},
          "facts": {"$ref": "#/$defs/facts"},
          "pass": {
            "additionalProperties": false,
            "properties": {"exit": {"const": 0}, "unit": {"const": "boolean"}, "value": {"const": true}},
            "required": ["exit", "unit", "value"],
            "type": "object"
          },
          "report_path": {"$ref": "#/$defs/path"},
          "report_sha256": {"$ref": "#/$defs/sha256"}
        },
        "required": ["candidate", "command", "criterion", "evidence_path", "evidence_sha256", "facts", "pass", "report_path", "report_sha256"],
        "type": "object"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "schema": {"const": "fiat-conformance-overlay/v1"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "transition": {"const": "step:4"}
  },
  "required": ["base", "contract_sha256", "rows", "schema", "sha256", "transition"],
  "type": "object",
  "$defs": {
    "digestedPath": {
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"],
      "type": "object"
    },
    "id": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
    "facts": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {"paid_or_answer_calls": {"const": 0}},
          "required": ["paid_or_answer_calls"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "isolated_authentication_proved": {"const": true},
            "metadata_get_count": {"const": 0},
            "metadata_get_endpoints": {"maxItems": 0, "type": "array"},
            "no_native_session": {"const": true},
            "paid_or_answer_calls": {"const": 0},
            "runtime_count": {"const": 2}
          },
          "required": ["isolated_authentication_proved", "metadata_get_count", "metadata_get_endpoints", "no_native_session", "paid_or_answer_calls", "runtime_count"],
          "type": "object"
        }
      ]
    },
    "path": {"maxLength": 1024, "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\/$)[\\u0020-\\u007e]+(?![\\s\\S])", "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
