{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/instruction-architecture/development-v1.schema.json",
  "title": "framework-74 neutral development workbench records",
  "oneOf": [
    {"$ref": "#/$defs/casesFile"},
    {"$ref": "#/$defs/prompt"},
    {"$ref": "#/$defs/adapterResults"},
    {"$ref": "#/$defs/score"},
    {"$ref": "#/$defs/mutationsFile"},
    {"$ref": "#/$defs/resourceFile"},
    {"$ref": "#/$defs/aggregateReport"},
    {"$ref": "#/$defs/controlFile"},
    {"$ref": "#/$defs/developmentInventory"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\/$)[\\u0020-\\u007e]+(?![\\s\\S])"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "path", "sha256", "start"],
      "properties": {
        "end": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0}
      }
    },
    "caseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "path", "sha256", "source_sha256", "start"],
      "properties": {
        "end": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"const": "exact-source-span"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "id", "response_shape", "scenario_id", "semantic_class", "source", "task"],
      "properties": {
        "expectation": {"$ref": "#/$defs/expectation"},
        "id": {"type": "string", "pattern": "^development-[0-9]{2}-[a-z-]+$"},
        "response_shape": {"enum": ["decision", "recovery", "refusal", "structured-plan", "tool-invocation"]},
        "scenario_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "semantic_class": {"enum": ["alias", "authority", "exception", "literal", "negation", "order", "recovery", "refusal", "scope", "unknown"]},
        "source": {"$ref": "#/$defs/caseSource"},
        "task": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "casesFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "cohorts_sha256", "manifest_sha256", "schema", "source_ref"],
      "properties": {
        "cases": {"type": "array", "minItems": 10, "maxItems": 128, "items": {"$ref": "#/$defs/case"}},
        "cohorts_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "wildcat-instruction-architecture-cases/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "encoding", "id", "kind", "source"],
      "properties": {
        "content": {"type": "string", "maxLength": 4194304},
        "encoding": {"enum": ["content-addressed-source", "exact-source", "exact-source-section", "raw-source-fallback", "utf-8-task", "wai1-compact"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["representation", "task"]},
        "source": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/span"}]}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "components", "scenario_id", "schema", "sha256"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "components": {"type": "array", "minItems": 2, "maxItems": 8192, "items": {"$ref": "#/$defs/component"}},
        "scenario_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "schema": {"const": "wildcat-instruction-architecture-prompt/v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recoveredSource": {"$ref": "#/$defs/span"},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovered_source", "status"],
      "properties": {
        "kind": {"enum": ["decision", "recovery", "refusal", "structured-plan", "tool-invocation"]},
        "recovered_source": {"$ref": "#/$defs/recoveredSource"},
        "status": {"enum": ["exact-source-recovered", "refused"]}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_success", "exact_fidelity", "fallback_used", "native_success", "trace_complete"],
      "properties": {
        "aggregate_success": {"type": "boolean"},
        "exact_fidelity": {"type": "boolean"},
        "fallback_used": {"type": "boolean"},
        "native_success": {"type": "boolean"},
        "trace_complete": {"type": "boolean"}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "mode", "original_paths", "representation_id"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "mode": {"enum": ["native", "raw-fallback"]},
        "original_paths": {"type": "array", "minItems": 1, "maxItems": 191, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "representation_id": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "adapterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "correlation_id", "outcome", "prompt", "scenario_id", "score", "selection_trace"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "correlation_id": {"$ref": "#/$defs/sha256"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "prompt": {"$ref": "#/$defs/prompt"},
        "scenario_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "score": {"$ref": "#/$defs/score"},
        "selection_trace": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/trace"}}
      }
    },
    "resultAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_success_cases", "cases", "exact_fidelity_cases", "fallback_cases", "native_success_cases", "prompt_bytes"],
      "properties": {
        "aggregate_success_cases": {"type": "integer", "minimum": 0},
        "cases": {"type": "integer", "minimum": 0},
        "exact_fidelity_cases": {"type": "integer", "minimum": 0},
        "fallback_cases": {"type": "integer", "minimum": 0},
        "native_success_cases": {"type": "integer", "minimum": 0},
        "prompt_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "adapterResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "arm", "case_set_sha256", "control_sha256", "results", "schema", "source_ref"],
      "properties": {
        "aggregate": {"$ref": "#/$defs/resultAggregate"},
        "arm": {"enum": ["noema", "raw", "section-graph", "simple", "wai1"]},
        "case_set_sha256": {"$ref": "#/$defs/sha256"},
        "control_sha256": {"$ref": "#/$defs/sha256"},
        "results": {"type": "array", "minItems": 10, "maxItems": 128, "items": {"$ref": "#/$defs/adapterResult"}},
        "schema": {"const": "wildcat-instruction-architecture-adapter-results/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_refusal", "id", "mutation", "risk_class"],
      "properties": {
        "expected_refusal": {"type": "string", "minLength": 1, "maxLength": 256},
        "id": {"type": "string", "pattern": "^hostile-[0-9]{2}-[a-z-]+$"},
        "mutation": {"type": "string", "minLength": 1, "maxLength": 128},
        "risk_class": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "mutationsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_ref", "specimens"],
      "properties": {
        "schema": {"const": "wildcat-instruction-architecture-mutations/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"},
        "specimens": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/mutation"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "ref", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/path"},
        "ref": {"$ref": "#/$defs/gitCommit"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoked", "record_count", "result_sha256", "status"],
      "properties": {
        "invoked": {"const": true},
        "record_count": {"type": "integer", "minimum": 1},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "pass"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "artifacts_sha256", "checker", "kind", "product_ref", "review_ref"],
      "properties": {
        "artifacts": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/artifact"}},
        "artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "checker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checker"}]},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "product_ref": {"$ref": "#/$defs/gitCommit"},
        "review_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/gitCommit"}]}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_defines_semantics", "fallback_is_aggregate_success", "fallback_is_native_coverage", "full_source_trace_required", "round_trip_scope"],
      "properties": {
        "candidate_defines_semantics": {"const": false},
        "fallback_is_aggregate_success": {"const": false},
        "fallback_is_native_coverage": {"const": false},
        "full_source_trace_required": {"const": true},
        "round_trip_scope": {"const": "exact-source-bytes"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "case_semantics", "fallback", "prompt", "score"],
      "properties": {
        "authority": {"const": "exact-canonical-source-bytes-at-source-ref"},
        "case_semantics": {"const": "exact-source-span"},
        "fallback": {"const": "exact-current-source-counted-as-not-native"},
        "prompt": {"const": "task-plus-representation-without-oracle-or-arm-label"},
        "score": {"const": "exact-source-recovery-and-native-mechanism"}
      }
    },
    "coverageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "end", "mode", "path", "reason", "representation_id", "sha256", "start"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["native", "raw-fallback"]},
        "path": {"$ref": "#/$defs/path"},
        "reason": {"type": "string", "maxLength": 128},
        "representation_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0}
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_physical_bytes", "fallback_physical_files", "fallback_ranges", "fallback_unique_bytes", "fallback_unique_files", "native_physical_bytes", "native_physical_files", "native_ranges", "native_unique_bytes", "native_unique_files", "physical_bytes", "physical_files", "unique_bytes", "unique_files"],
      "properties": {
        "fallback_physical_bytes": {"type": "integer", "minimum": 0},
        "fallback_physical_files": {"type": "integer", "minimum": 0},
        "fallback_ranges": {"type": "integer", "minimum": 0},
        "fallback_unique_bytes": {"type": "integer", "minimum": 0},
        "fallback_unique_files": {"type": "integer", "minimum": 0},
        "native_physical_bytes": {"type": "integer", "minimum": 0},
        "native_physical_files": {"type": "integer", "minimum": 0},
        "native_ranges": {"type": "integer", "minimum": 0},
        "native_unique_bytes": {"type": "integer", "minimum": 0},
        "native_unique_files": {"type": "integer", "minimum": 0},
        "physical_bytes": {"type": "integer", "minimum": 0},
        "physical_files": {"type": "integer", "minimum": 0},
        "unique_bytes": {"type": "integer", "minimum": 0},
        "unique_files": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranges", "summary"],
      "properties": {
        "ranges": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/coverageRange"}},
        "summary": {"$ref": "#/$defs/coverageSummary"}
      }
    },
    "nativeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "id", "path", "representation_bytes", "representation_path", "representation_sha256", "source_sha256", "start"],
      "properties": {
        "end": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"$ref": "#/$defs/path"},
        "representation_bytes": {"type": "integer", "minimum": 1},
        "representation_path": {"$ref": "#/$defs/path"},
        "representation_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0}
      }
    },
    "fileNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "id", "path", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sectionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "end", "id", "path", "sha256", "start", "title_sha256"],
      "properties": {
        "dependencies": {"type": "array", "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "end": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^section:[0-9a-f]{64}$"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0},
        "title_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": {"enum": ["exact-content-alias", "section-parent"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 1024},
        "target": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "controlGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "nodes"],
      "properties": {
        "edges": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/graphEdge"}},
        "nodes": {"type": "array", "maxItems": 32768, "items": {"oneOf": [{"$ref": "#/$defs/fileNode"}, {"$ref": "#/$defs/sectionNode"}]}}
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_native_bytes", "current_native_envelopes", "current_native_in_current_coverage", "scope", "stale_sources", "synthetic_in_aggregate_success", "synthetic_in_current_coverage", "synthetic_mapped_bytes", "synthetic_mapped_spans"],
      "properties": {
        "current_native_bytes": {"type": "integer", "minimum": 0},
        "current_native_envelopes": {"type": "integer", "minimum": 0},
        "current_native_in_current_coverage": {"type": "boolean"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 128},
        "stale_sources": {"type": "integer", "minimum": 0},
        "synthetic_in_aggregate_success": {"type": "boolean"},
        "synthetic_in_current_coverage": {"type": "boolean"},
        "synthetic_mapped_bytes": {"type": "integer", "minimum": 0},
        "synthetic_mapped_spans": {"type": "integer", "minimum": 0}
      }
    },
    "controlFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "binding", "claims", "contract", "coverage", "graph", "manifest_sha256", "mechanism_evidence", "native_mappings", "schema", "source_ref"],
      "properties": {
        "arm": {"enum": ["noema", "raw", "section-graph", "simple", "wai1"]},
        "binding": {"$ref": "#/$defs/binding"},
        "claims": {"$ref": "#/$defs/claims"},
        "contract": {"$ref": "#/$defs/contract"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "graph": {"$ref": "#/$defs/controlGraph"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "mechanism_evidence": {"$ref": "#/$defs/mechanism"},
        "native_mappings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/nativeMapping"}},
        "schema": {"const": "wildcat-instruction-architecture-control/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "resourceSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "wall_time_budget_ms", "work_units"],
      "properties": {
        "phase": {"enum": ["assemble", "parse-validate", "select"]},
        "wall_time_budget_ms": {"type": "integer", "minimum": 1},
        "work_units": {"type": "integer", "minimum": 1}
      }
    },
    "resourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_payload_bytes", "dependency_count", "executable_loc", "limits", "samples", "schema", "source_ref", "timing_policy"],
      "properties": {
        "artifact_payload_bytes": {"type": "integer", "minimum": 1},
        "dependency_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external_runtime", "standard_library_modules"],
          "properties": {"external_runtime": {"const": 0}, "standard_library_modules": {"type": "integer", "minimum": 1}}
        },
        "executable_loc": {"type": "integer", "minimum": 1},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_control_paths", "max_development_cases", "max_model_output_bytes", "max_prompt_bytes", "max_prompt_components", "peak_rss_bytes"],
          "properties": {
            "max_control_paths": {"type": "integer", "minimum": 1},
            "max_development_cases": {"type": "integer", "minimum": 1},
            "max_model_output_bytes": {"type": "integer", "minimum": 1},
            "max_prompt_bytes": {"type": "integer", "minimum": 1},
            "max_prompt_components": {"type": "integer", "minimum": 1},
            "peak_rss_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "samples": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/resourceSample"}},
        "schema": {"const": "wildcat-instruction-architecture-resource-samples/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"},
        "timing_policy": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "reportArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "control_sha256", "development_aggregate_success_cases", "development_case_count", "development_exact_fidelity_cases", "development_fallback_cases", "development_native_success_cases", "full_current_corpus_fallback_bytes", "full_current_corpus_native_bytes", "full_current_corpus_native_ranges", "synthetic_in_aggregate_success", "synthetic_in_current_coverage", "synthetic_mapped_bytes", "synthetic_mapped_spans"],
      "properties": {
        "arm": {"enum": ["noema", "raw", "section-graph", "simple", "wai1"]},
        "control_sha256": {"$ref": "#/$defs/sha256"},
        "development_aggregate_success_cases": {"type": "integer", "minimum": 0},
        "development_case_count": {"type": "integer", "minimum": 0},
        "development_exact_fidelity_cases": {"type": "integer", "minimum": 0},
        "development_fallback_cases": {"type": "integer", "minimum": 0},
        "development_native_success_cases": {"type": "integer", "minimum": 0},
        "full_current_corpus_fallback_bytes": {"type": "integer", "minimum": 0},
        "full_current_corpus_native_bytes": {"type": "integer", "minimum": 0},
        "full_current_corpus_native_ranges": {"type": "integer", "minimum": 0},
        "synthetic_in_aggregate_success": {"type": "boolean"},
        "synthetic_in_current_coverage": {"type": "boolean"},
        "synthetic_mapped_bytes": {"type": "integer", "minimum": 0},
        "synthetic_mapped_spans": {"type": "integer", "minimum": 0}
      }
    },
    "aggregateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "case_set_sha256", "cohorts_sha256", "holdout", "invariants", "manifest_sha256", "schema", "source_ref"],
      "properties": {
        "arms": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/reportArm"}},
        "case_set_sha256": {"$ref": "#/$defs/sha256"},
        "cohorts_sha256": {"$ref": "#/$defs/sha256"},
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases_accessed", "opened"],
          "properties": {"cases_accessed": {"const": 0}, "opened": {"const": false}}
        },
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_independent_oracle", "fallback_is_aggregate_success", "fallback_is_native_coverage", "synthetic_noema_is_current_coverage"],
          "properties": {
            "candidate_independent_oracle": {"const": true},
            "fallback_is_aggregate_success": {"const": false},
            "fallback_is_native_coverage": {"const": false},
            "synthetic_noema_is_current_coverage": {"const": false}
          }
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "wildcat-instruction-architecture-aggregate-report/v1"},
        "source_ref": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "inventoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "developmentInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "case_set_sha256", "cohorts_sha256", "loader_graph_sha256", "manifest_sha256", "schema", "source_ref", "source_tree_sha256"],
      "properties": {
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 14,
