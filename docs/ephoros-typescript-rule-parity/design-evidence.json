  "candidates": [
    {
      "id": "span-index",
      "summary": "Extend the existing bracket-anchored TypeScript pass and its per-file span index inside check_typescript, so the three recognisers reuse the masked lexer, the bracket-match table and the depth-zero punctuation tables the E005 pass already builds."
    },
    {
      "id": "unmasked-regex",
      "summary": "Recognise the three shapes with regular expressions over the raw file text, with no lexer and no mask, the cheapest strategy to write."
    },
    {
      "id": "forward-scan",
      "summary": "Add a second, independent pass over the masked text that walks every identifier chain forward to its bracket and reads each argument span on its own, sharing the lexer but none of the span index."
    }
  ],
