{
  "candidates": [
    {
      "id": "dispatcher-grant-wal",
      "summary": "One dispatcher evaluates a pure closed gate under the run lock; every writer needs its grant; one labelled write-ahead commit; exhausted loops continue append-only."
    },
    {
      "id": "per-handler-gate",
      "summary": "Each mutating handler calls the pure gate itself and the controller's present ledger-then-state writer stays as it is; exhausted loops continue append-only."
    },
    {
      "id": "external-writer-broker",
      "summary": "The gate grants in process but a separate broker process under another OS identity owns the state writer and the pins; exhausted loops continue append-only."
    },
    {
      "id": "gate-with-replacement-exit",
      "summary": "The dispatcher gate and write-ahead commit without a same-ledger loop; an exhausted loop leaves only by the existing verdict close, halt or replacement admission."
    }
  ],
