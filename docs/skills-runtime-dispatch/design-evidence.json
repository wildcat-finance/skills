      "id": "destination-poll-faster",
      "summary": "Keep the pull model and add a faster cron entry in the destination job."
    },
    {
      "id": "source-push",
      "summary": "Generate in wildcat-finance/skills on push to main and push the package into skills-runtime with a contents-write credential (ADR-066 option B)."
    }
