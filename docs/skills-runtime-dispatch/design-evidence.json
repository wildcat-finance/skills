    {
      "id": "source-dispatch",
      "summary": "A push-to-main workflow in wildcat-finance/skills starts the destination's existing workflow_dispatch job with a token scoped to Actions write on skills-runtime only; the destination job is unchanged."
    },
    {
      "id": "reregister-schedule",
      "summary": "Change the cron expression in both copies of sync.yml so GitHub re-registers the schedule; a workflow-scope push to the destination."
    },
