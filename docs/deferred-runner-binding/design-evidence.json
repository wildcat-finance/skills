{
  "candidates": [
    {
      "id": "creating-step-binding",
      "summary": "A command-interfaces row names a runner path and builder with step:1 in place of a digest; the path must be absent at runbook capture, its commands are checked for shape only until Step 1's push, and Fiat then binds the pushed blob's SHA-256 so every later replay uses the ordinary pinned route."
    },
    {
      "id": "reviewed-stdlib-runner",
      "summary": "Hexaemeron ships one reviewed single-process stdlib unittest runner whose digest and interface sit in the controller; a target row names it by reviewed identity, the interface is checked at runbook capture from the shipped bytes, and Step 1 must commit a byte-identical copy."
    },
    {
      "id": "runbook-embedded-source",
      "summary": "The runbook carries the complete runner source in a new fenced block; the gate checks the interface from those runbook bytes at capture, and Step 1 must commit exactly the embedded bytes; a change needs an amendment carrying a replacement source block."
    },
    {
      "id": "pre-placed-untracked",
      "summary": "The released 1.6.82 route: the runner is written into the run worktree as an untracked file before done runbook, registered by whole-file SHA-256, and Step 1 commits those bytes unchanged; a change needs an amendment with a replacement row."
    }
  ],
