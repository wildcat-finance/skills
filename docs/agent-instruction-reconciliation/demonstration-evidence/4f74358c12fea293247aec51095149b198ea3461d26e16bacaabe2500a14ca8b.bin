from pathlib import Path
import contextlib,importlib.util,io,json,sys,unittest
ROOT=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT));sys.path.insert(0,str(ROOT/'scripts'))
import agent_instruction_reconciliation as current
from tests import test_agent_instruction_reconciliation as guards
from tests.emit_run_observation_report import result_payload
mode=sys.argv[1];out=ROOT/'.hexaemeron/demo-build'/('exchange-counterfactual-'+mode);out.mkdir()
source=ROOT/('.hexaemeron/step-2-parent-race-unfixed.py' if mode=='old' else 'scripts/agent_instruction_reconciliation.py')
if mode=='old':
 spec=importlib.util.spec_from_file_location('unfixed_exchange',source);old=importlib.util.module_from_spec(spec);spec.loader.exec_module(old)
 guards.air=old
stdout=io.StringIO();stderr=io.StringIO()
with contextlib.redirect_stdout(stdout),contextlib.redirect_stderr(stderr):
 suite=unittest.TestSuite([guards.ReconciliationTests('test_final_publication_syscall_preserves_concurrent_version')])
 result=unittest.TextTestRunner(stream=stderr,verbosity=2).run(suite)
for name,body in [('stdout',stdout.getvalue().encode()),('stderr',stderr.getvalue().encode()),('report.json',current.encoded(result_payload(result))),('helper.py',source.read_bytes()),('tests.py',(ROOT/'tests/test_agent_instruction_reconciliation.py').read_bytes())]:
 (out/name).write_bytes(body)
print(json.dumps(result_payload(result)))
raise SystemExit(0 if result.wasSuccessful() else 1)
