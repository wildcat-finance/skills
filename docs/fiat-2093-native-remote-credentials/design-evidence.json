{
  "candidates": [
    {
      "id": "credential-scope-projection",
      "summary": "Keep the native ls-remote; read the caller's credential.* entries (every scope but command) with the caller's Git, replay them in command scope after one empty helper reset, and add HOME. Local relation reads keep the unchanged native environment."
    },
    {
      "id": "github-rest-tip",
      "summary": "For a GitHub origin, read the branch tip over GitHub REST through the caller's gh as pull requests are read today; any other origin keeps the unchanged native ls-remote."
    },
    {
      "id": "credential-fill-relay",
      "summary": "Run git credential fill in the caller's environment for the native origin host, then relay the returned username and password to the native ls-remote through a controller-owned helper and two environment variables."
    },
    {
      "id": "native-unchanged",
      "summary": "Baseline: keep today's native environment and wording; an operator adds a repository-local credential helper around one call, as the 2026-10-13 MR-03 receipt did."
    }
  ],
