{
  "schema": "protasis-design-evidence/v1",
  "candidates": [
    {
      "id": "example-payload-class",
      "summary": "Keep the cap, the reserve and one package. One class omits non-Markdown files under plugins/*/examples/ except files a packaged document links and the one complete Lazarus release; it replaces the five example-specific omission rows. The full source checkout stays the home of demonstration payloads."
    },
    {
      "id": "second-distribution",
      "summary": "Keep the cap and the reserve. Move example and documentation trees that no packaged document links into a second generated package published from a second repository, with its own manifest, verifier and a human-pushed rebuild workflow."
    },
    {
      "id": "lower-reserve",
      "summary": "Keep every packaged file. Lower the reserve ADR-090 set from 5,242,880 to 2,097,152 bytes so generation refuses at 24,117,248 bytes."
    },
    {
      "id": "plugin-budgets",
      "summary": "Keep every packaged file, the cap and the reserve. Divide the 20,971,520-byte line into per-plugin byte budgets so the plugin that grows is the one refused."
    }
  ],
