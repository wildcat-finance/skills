        "entry_point": "src/market/WildcatMarketBase.sol:474",
        "gate": "onlyBorrower, src/market/WildcatMarketBase.sol:348",
        "note": "a pending borrower holds no market authority. The three principal fields are ordinary data, so this event cannot be filtered by principal."
      },
      {
        "transition": "borrower transfer cancelled",
        "event": "BorrowerTransferCancelled",
        "field": "borrower, cancelledPendingBorrower (indexed); borrowerPrincipal, cancelledPendingBorrowerPrincipal (data)",
