        "entry_point": "src/market/WildcatMarketBase.sol:496",
        "gate": "onlyBorrower, src/market/WildcatMarketBase.sol:348",
        "note": "both principal fields are ordinary data."
      },
      {
        "transition": "borrower transfer completed",
        "event": "BorrowerTransferred",
        "field": "previousBorrower, newBorrower, newBorrowerPrincipal (indexed); previousBorrowerPrincipal (data)",
        "actor_class": "debtor and registry-derived owner",
        "address_source": "pendingBorrower() for newBorrower; the principal validated by _validateBorrowerTransferTarget at src/market/WildcatMarketBase.sol:518 for newBorrowerPrincipal; borrower() and borrowerPrincipal() for the previous pair",
        "emitted_at": "src/market/WildcatMarketBase.sol:530",
        "entry_point": "src/market/WildcatMarketBase.sol:513",
        "gate": "msg.sender != pendingBorrower() reverts, src/market/WildcatMarketBase.sol:515; this path is not onlyBorrower",
        "note": "the only event in the family that indexes a registry-derived principal, so the transfer lifecycle cannot be filtered by principal end to end."
