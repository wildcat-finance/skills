    {
      "id": "declared-wrapper-subjects",
      "summary": "A V2 plan declares its wrappers in an optional field; each is admitted only by a preserved WrapperDeployed log from the registry's wrapper factory naming a registry market, and joins the ordinary logs journal."
    },
    {
      "id": "discovered-wrapper-journal",
      "summary": "A V2 plan opts in with a rule alone; after the shards the collector derives wrappers from staged WrapperDeployed logs and walks a new post-shard wrapper-logs journal class."
    },
    {
      "id": "registry-wrapper-role",
      "summary": "Add a wrapper role to the pinned V2 registry, generated from a merged record listing deployed wrappers."
    },
    {
      "id": "separate-wrapper-venue",
      "summary": "A new wildcat-v2-wrappers venue with its own module and releases, taking its wrapper set from an earlier V2 release."
    }
