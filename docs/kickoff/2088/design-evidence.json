  "candidates": [
    {
      "id": "abi-named-amounts",
      "summary": "Map both events as pool rows whose amounts are the numeric ABI fields under kebab-case ABI names in native units; timestamps and isDelinquent stay decoded native state."
    },
    {
      "id": "unit-named-amounts",
      "summary": "Map both events as pool rows whose amount kinds name only a unit: ray for the three ray-scaled fields and assets for protocolFees."
    },
    {
      "id": "native-state-only",
      "summary": "Map both events as pool rows with empty amounts; every field stays decoded native state, as MarketClosed keeps its timestamp."
    },
    {
      "id": "envelope-native-state",
      "summary": "ABI-named amounts plus a native_state row field under a schema_version 4 envelope carrying the timestamps and isDelinquent."
    }
