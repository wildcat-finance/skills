{
  "candidates": [
    {
      "id": "base-commit-bindings",
      "summary": "Admit a registered module whose bytes equal its blob at the run's starting commit under the pin that commit's adapter carried, and a receipt adapter digest equal to that commit's adapter digest; both derived from Git at check time, no table."
    },
    {
      "id": "reviewed-prior-pins",
      "summary": "Extend the reviewed tables: add ac527913 to REPLAY_COMPATIBLE_ADAPTERS and a prior-pin triple for protasis.py; one reviewed row set per later controller."
    },
    {
      "id": "runbook-scoped-pins",
      "summary": "Keep pin checks scoped to the modules the runbook names, which is already the case, and stop the diagnostic naming unused modules; no admission change."
    },
    {
      "id": "recorded-controller-fork",
      "summary": "Drive the run on its recorded controller rebuilt from the starting commit with supersede-commit backported; main's controller is unchanged."
    }
  ],
