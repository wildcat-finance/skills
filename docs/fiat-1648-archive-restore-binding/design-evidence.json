{
  "schema": "protasis-design-evidence/v1",
  "candidates": [
    {
      "id": "path-unchanged",
      "summary": "Today's restore: every operation after admission resolves the destination by its absolute path; the admission descriptor is held unused."
    },
    {
      "id": "identity-recheck",
      "summary": "Keep absolute paths and re-prove before and after every operation and Git child that the destination name still names the admitted inode."
    },
    {
      "id": "anchored-cwd",
      "summary": "fchdir to the admitted descriptor after the inspector; every controller operation is cwd- or dir_fd-relative, every Git child inherits that cwd, and identity seals bracket each Git child and each name-dependent step."
    },
    {
      "id": "private-build-adopt",
      "summary": "Build repository, capsule, marker and worktree in a private scratch directory, then adopt each entry into the admitted directory by descriptor-relative rename and repoint Git's worktree links."
    }
  ],
