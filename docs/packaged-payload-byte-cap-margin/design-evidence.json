{
  "schema": "protasis-design-evidence/v1",
  "candidates": [
    {
      "id": "omission-class",
      "summary": "Declare a package omission class for the 32 character-portrait assets, on the recorded ground that the repository's own Horos boundary classifies every one as binary/hard. The files stay tracked; only the generated package omits them. The packaged documents that referenced a portrait are left as they stand."
    },
    {
      "id": "omission-class-with-reference-repair",
      "summary": "The same omission class, and the generator additionally rewrites, in the packaged copy alone, every img tag whose target left the package, replacing that tag with an HTML comment naming the omitted path. Repository copies are unchanged and every file stays tracked."
    },
    {
      "id": "second-package",
      "summary": "Split the generated runtime into two published skills.sh packages, each below both extract caps, each with its own grouping and install address."
    },
    {
      "id": "warning-gate",
      "summary": "Change no bytes and no route. Move the package test's byte assertion off the cap onto a stated warning threshold, so CI fails with margin left rather than at the ceiling."
    }
  ],
