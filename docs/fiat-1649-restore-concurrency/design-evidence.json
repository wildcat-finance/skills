{
  "schema": "protasis-design-evidence/v1",
  "candidates": [
    {
      "id": "mutating-set",
      "summary": "Add cmd_checkpoint_restore to MUTATING and keep held_lock unchanged: the run lock is taken only where the --dir already has a state root."
    },
    {
      "id": "destination-kernel-lock",
      "summary": "Create and flock the run lock at <destination>/.hexaemeron/lock through the admitted descriptor right after admission, re-scan, carry a lock in the private stage, and close held_lock's absent-root window."
    },
    {
      "id": "exclusive-entry",
      "summary": "Create one O_EXCL entry relative to the admitted descriptor after admission, re-scan, reclaim it when its recorded holder is dead, carry a lock in the private stage, and close held_lock's absent-root window."
    },
    {
      "id": "admitted-fd-flock",
      "summary": "flock the admitted (or --from origin) directory descriptor before the emptiness scan, take the origin's run lock inside the marker transaction, carry a lock in the private stage through publication, and close held_lock's absent-root window."
    }
  ],
