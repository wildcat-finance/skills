#!/bin/sh
# Run the suite and, on exit zero alone, record the staged tree as green.
#
#     git add -A && .githooks/greenlight && git commit
#
# The recorded identity is the tree `git write-tree` produces from the index as
# it stands now, so stage before running this. Nothing here stages anything: a
# command that quietly changed the index would be recording a tree the suite
# never saw.
#
# The record lives under `git rev-parse --git-dir`, which is per-worktree, so a
# green recorded in one worktree cannot authorise a commit in another.
#
# It is a convenience rather than proof that the suite ran. The file carries no
# provenance and anyone who can write the git directory can write it. See
# docs/decisions/draft-activate-the-commit-gate-from-a-tracked-hooks-directory.md

set -eu

# The suite and the recorded tree have to be the same repository, and git's own
# answers cannot establish that on their own. Git exports GIT_DIR into every
# hook and every command it runs, and with GIT_DIR inherited `git rev-parse
# --show-toplevel` reports the *caller's* directory as the working tree while
# `git write-tree` still reads the index GIT_DIR names. Run from anywhere with
# that variable set, the original `cd "$(git rev-parse --show-toplevel)"` landed
# in the caller's directory, ran whatever `tests/` was there, and recorded a
# green for another repository's staged tree. The substitution failing was never
# the only way in: `cd ""` is a no-op and a failed substitution inside a simple
# command's arguments does not trip `set -e`, but here the substitution
# succeeds and simply answers about the wrong directory.
#
# So drop the redirection git may have exported, then anchor to the one thing
# the environment cannot move: where this script is. The hook does the opposite
# and correctly so -- it is invoked by git, and the index git exports is exactly
# the one it is meant to check.
#
# The last two are the configuration half of the same problem. Git carries the
# caller's one-shot configuration in GIT_CONFIG_PARAMETERS, and in
# GIT_CONFIG_COUNT with the indexed GIT_CONFIG_KEY_<n>/GIT_CONFIG_VALUE_<n>
# pairs it drives; the pairs are inert once the count is gone. Either form
# supplying `core.fsmonitor` makes the git calls below start a command nobody
# here named, measured on git 2.50.1.
#
# GIT_CONFIG_GLOBAL and GIT_CONFIG_SYSTEM reach the same end one indirection
# further out, because a file either of them names can carry `core.fsmonitor`
# itself. Unsetting them would be worse than leaving them: git then falls back
# to `$HOME/.gitconfig` and `/etc/gitconfig`, and a `core.fsmonitor` in
# `$HOME/.gitconfig` still ran. They are pointed at nothing instead, which is
# git's documented way to skip a configuration level outright. That is scoped
# to this script's own git calls through `gate_git` below, because the suite
# this script runs is not the gate and must keep running in the contributor's
# own configuration.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE \
    GIT_PREFIX GIT_INTERNAL_SUPER_PREFIX \
    GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

gate_git() {
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null git "$@"
}

here="$(dirname "$0")"
cd "$here/.."

# Assignment form, so a rev-parse failure reaches `set -e`.
toplevel="$(gate_git rev-parse --show-toplevel)"
cd "$toplevel"

python3 -m unittest discover -s tests

tree="$(gate_git write-tree)"
record="$(gate_git rev-parse --git-dir)/LAST_GREEN"
printf '%s\n' "$tree" > "$record"
printf 'greenlight: recorded tree %s in %s\n' "$tree" "$record"
